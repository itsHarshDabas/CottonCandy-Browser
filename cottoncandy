def _short_label(url, title):
    host = url_parts(url)["host"] or url
    host = re.sub(r"^(www|docs|doc|wiki|m)\.", "", host)
    return host.split(":")[0]


def error_html(tokens, kind, url, code, message="", ai=False):
    """An error page in the new tab page style. url is the page that failed; nothing here runs code.
    ai adds "Explain this error", which opens the Grace panel."""
    host = url_parts(url)["host"] or url
    try_again = '<a class="pill primary" href="{}">Try again</a>'.format(_esc(url))
    back = '<a class="pill" href="{}://back">Go back</a>'.format(INTERNAL_SCHEME)
    if kind == "cert":
        icon, cls = "shieldx", "icon bad"
        title = "This connection isn’t private"
        text = "{} sent a certificate CottonCandy can’t trust, so someone may be able to read what you send. CottonCandy never lets you continue past a bad certificate.".format(_esc(host))
        buttons = '<a class="pill primary" href="{}://back">Go back</a>'.format(INTERNAL_SCHEME)
    elif kind == "offline":
        icon, cls = "wifioff", "icon"
        title = "You’re offline"
        text = "CottonCandy can’t reach {}. Check the network, then try again.".format(_esc(host))
        buttons = try_again + back
    elif kind == "dns":
        icon, cls = "globe", "icon"
        title = "Can’t find {}".format(_esc(host))
        text = "The address may be mistyped, or the site may not exist."
        buttons = try_again + back
    else:
        icon, cls = "alert", "icon"
        title = "Can’t reach {}".format(_esc(host))
        text = _esc(message) if message else "The site didn’t answer."
        buttons = try_again + back
    if ai:
        buttons += '<a class="pill" href="{}://explain">{} Explain this error</a>'.format(INTERNAL_SCHEME, svg_icon("spark", tokens["accent_text"], 14))
    color = tokens["error"] if kind == "cert" else tokens["text_secondary"]
    body = '<main class="err"><div class="{cls}">{icon}</div><h1>{title}</h1><p>{text}</p><code>{code}</code><div class="btns">{buttons}</div></main>'.format(
        cls=cls, icon=svg_icon(icon, color, 28), title=title, text=text, code=_esc(code), buttons=buttons)
    return _page(tokens, title.replace("&amp;", "&"), body)


def internal_request(url):
    """What a cottoncandy: URL asks for: ('newtab', None), ('search', text), ('back', None), ('explain', None)
    or (None, None)."""
    match = re.match(r"^%s://([a-z]+)/?(\?.*)?$" % INTERNAL_SCHEME, url or "")
    if not match:
        return None, None
    page, query = match.group(1), match.group(2) or ""
    if page == "search":
        from urllib.parse import parse_qs

        values = parse_qs(query[1:]).get("q", [""])
        return "search", values[0]
    if page in ("newtab", "back", "explain"):
        return page, None
    return None, None


