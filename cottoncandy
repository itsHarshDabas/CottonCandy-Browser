    class TrafficLights(QWidget):
        """Close, minimize, maximize on the left; glyphs appear while hovered; gray when the window is inactive."""

        def __init__(self, window):
            super().__init__()
            self._window = window
            self._hover = False
            self.setFixedSize(58, 30)
            self.setAccessibleName("Window controls: close, minimize, maximize")
            self.setToolTip("Close · Minimize · Maximize")

        def _centers(self):
            return [QPoint(9 + i * 18, self.height() // 2) for i in range(3)]

        def enterEvent(self, event):
            self._hover = True
            self.update()

        def leaveEvent(self, event):
            self._hover = False
            self.update()

        def paintEvent(self, event):
            painter = QPainter(self)
            painter.setRenderHint(QPainter.RenderHint.Antialiasing)
            active = self._window.isActiveWindow()
            for index, center in enumerate(self._centers()):
                fill = QColor(TRAFFIC_LIGHTS[index]) if active or self._hover else qcolor(tok()["control_hover"])
                painter.setPen(QPen(QColor(0, 0, 0, 72), 0.5))
                painter.setBrush(fill)
                painter.drawEllipse(QPointF(center), 5.5, 5.5)
                if self._hover:
                    pen = QPen(QColor(0, 0, 0, 140), 1.3)
                    pen.setCapStyle(Qt.PenCapStyle.RoundCap)
                    painter.setPen(pen)
                    x, y = center.x(), center.y()
                    if index == 0:
                        painter.drawLine(QPointF(x - 2.5, y - 2.5), QPointF(x + 2.5, y + 2.5))
                        painter.drawLine(QPointF(x + 2.5, y - 2.5), QPointF(x - 2.5, y + 2.5))
                    else:
                        painter.drawLine(QPointF(x - 3, y), QPointF(x + 3, y))
                        if index == 2:
                            painter.drawLine(QPointF(x, y - 3), QPointF(x, y + 3))
            painter.end()

        def mousePressEvent(self, event):
            for index, center in enumerate(self._centers()):
                if (event.position().toPoint() - center).manhattanLength() <= 9:
                    if index == 0:
                        self._window.close()
                    elif index == 1:
                        self._window.showMinimized()
                    else:
                        self._window.toggle_maximized()
                    return
            super().mousePressEvent(event)

