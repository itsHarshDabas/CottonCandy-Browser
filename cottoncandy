                row.addWidget(button)
            request = download.request
            request.receivedBytesChanged.connect(self.refresh)
            request.stateChanged.connect(self.refresh)
            request.isPausedChanged.connect(self.refresh)
            self.refresh()

        def refresh(self, *_args):
            download, request = self._download, self._download.request
            running = download.running()
            states = QWebEngineDownloadRequest.DownloadState
            text, failed = download.status()
            self.status.setText(text)
            self.status.setObjectName("failed" if failed else "secondary")
            repolish(self.status)
            self.bar.setVisible(running)
            self.bar.setProperty("paused", request.isPaused())
            repolish(self.bar)
            total = request.totalBytes()
            if total > 0:
                self.bar.setRange(0, 1000)
                self.bar.setValue(int(request.receivedBytes() * 1000 / total))
            else:
                self.bar.setRange(0, 0)
            self.pause.setVisible(running)
            set_icon(self.pause, "play" if request.isPaused() else "pause")
            self.pause.setToolTip("Resume" if request.isPaused() else "Pause")
            self.cancel.setVisible(running)
            self.folder.setVisible(request.state() == states.DownloadCompleted)
            self.retry.setVisible(request.state() == states.DownloadInterrupted)

        def _toggle_pause(self):
            request = self._download.request
            request.resume() if request.isPaused() else request.pause()

        def _show_folder(self):
            # Only the folder: opening a downloaded file straight from the browser is how malware runs.
            QDesktopServices.openUrl(QUrl.fromLocalFile(os.path.dirname(self._download.path)))

        def _retry(self):
            self._window.retry_download(self._download)

