    def image(icon, size):
        return '<img src="{}" alt="">'.format(_esc(icon)) if icon else '<span class="glyph">{}</span>'.format(svg_icon("globe", secondary, size))

    tiles = "".join(
        '<a class="sc" href="{u}" title="{full}">{img}<span>{label}</span></a>'.format(
