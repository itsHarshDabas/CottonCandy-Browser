        def _build_menu(self):
            menu = QMenu(self)
            for name in ("New Tab", "New Window", "New Private Window", None,
                         "History", "Bookmarks", "Downloads", None,
                         "Find", "Zoom In", "Zoom Out", "Reset Zoom", "Full Screen", None,
                         "Developer Tools", None):
                if name is None:
                    menu.addSeparator()
                else:
                    menu.addAction(self._action(name))
            menu.addAction("Make CottonCandy the Default Browser", self._on_make_default)
            menu.addSeparator()
            menu.addAction(self._action("Quit"))
            return menu

        def _action(self, name):
            for action in self.actions():
                if action.text() == name:
                    return action
            raise KeyError(name)

        def _build_find_bar(self):
            bar = QWidget()
            bar.setObjectName("findbar")
            row = QHBoxLayout(bar)
            row.setContentsMargins(8, 4, 8, 6)
            self._find_entry = QLineEdit()
            self._find_entry.setPlaceholderText("Find in page")
            self._find_entry.setMaximumWidth(320)
            self._find_entry.textChanged.connect(lambda _text: self._find(False))
            self._find_entry.returnPressed.connect(lambda: self._find(False))
            self._find_count = QLabel()
            self._find_count.setObjectName("secondary")
            previous = tool_button("back", "Previous match (Shift+Enter)", lambda: self._find(True))
            following = tool_button("forward", "Next match (Enter)", lambda: self._find(False))
            close = tool_button("x", "Close (Esc)", self._close_find)
            row.addWidget(self._find_entry)
            row.addWidget(previous)
            row.addWidget(following)
            row.addWidget(self._find_count)
            row.addStretch(1)
            row.addWidget(close)
            self._find_entry.installEventFilter(self)
            bar.hide()
            return bar

        def eventFilter(self, watched, event):
            if watched is self._find_entry and event.type() == QEvent.Type.KeyPress:
                if event.key() == Qt.Key.Key_Escape:
                    self._close_find()
                    return True
                if event.key() in (Qt.Key.Key_Return, Qt.Key.Key_Enter) and event.modifiers() & Qt.KeyboardModifier.ShiftModifier:
                    self._find(True)
                    return True
            return super().eventFilter(watched, event)

        # ---- tabs ----

        def add_tab(self, url=HOME_URL, focus=True, after=None):
            tab = CottonTab(self, self._profile)
            index = len(self._tabs)
            if after is not None:
                for position, existing in enumerate(self._tabs):
                    if existing.page is after:
                        index = position + 1
            self._tabs.insert(index, tab)
            self._stack.addWidget(tab.view)
            self._tab_bar.insertTab(index, "New Tab")
            close = tool_button("x", "Close tab (Ctrl+W)", lambda: self._close_tab(tab))
            close.setIconSize(QSize(12, 12))
            self._tab_bar.setTabButton(index, QTabBar.ButtonPosition.RightSide, close)
            self._connect_tab(tab)
            if url:
                tab.view.load(QUrl(url))
                self._sync_background(tab, url)
            if focus or len(self._tabs) == 1:
                self._tab_bar.setCurrentIndex(index)
                if not url or url == HOME_URL:
                    QTimer.singleShot(0, self._on_focus_address)
                else:
                    tab.view.setFocus()
            return tab

        def _connect_tab(self, tab):
            view = tab.view
            page = tab.page
            view.titleChanged.connect(lambda title: self._on_title_changed(tab, title))
            view.urlChanged.connect(lambda url: self._on_url_changed(tab, url))
            view.iconChanged.connect(lambda tab_icon: self._set_tab_icon(tab, tab_icon))
            view.loadStarted.connect(lambda: self._on_load_started(tab))
            view.loadProgress.connect(lambda value: self._on_load_progress(tab, value))
            view.loadFinished.connect(lambda ok: self._on_load_finished(tab, ok))
            view.renderProcessTerminated.connect(lambda status, code: self._on_crashed(tab, status))
            page.linkHovered.connect(self._show_bubble)
            page.permissionRequested.connect(lambda permission: self._on_permission(tab, permission))
            page.certificateError.connect(self._on_certificate_error)
            page.fullScreenRequested.connect(self._on_fullscreen_requested)
            page.findTextFinished.connect(self._on_find_result)
            page.windowCloseRequested.connect(lambda: self._close_tab(tab))

        def _index_of(self, tab):
            return self._tabs.index(tab) if tab in self._tabs else -1

        def _current(self):
            index = self._tab_bar.currentIndex()
            return self._tabs[index] if 0 <= index < len(self._tabs) else None

        def _close_tab(self, tab):
            index = self._index_of(tab)
            if index >= 0:
                self._close_tab_at(index)

        def _close_tab_at(self, index):
            if not 0 <= index < len(self._tabs):
                return
            tab = self._tabs.pop(index)
            self._tab_bar.removeTab(index)
            self._dispose_tab(tab)
            if not self._tabs:
                self.close()

        def _dispose_tab(self, tab):
            if tab.devtools is not None:
                tab.devtools.close()
            self._stack.removeWidget(tab.view)
            tab.view.setParent(None)
            tab.view.deleteLater()  # its page is a child, so it goes too

        def _on_tab_moved(self, source, destination):
            self._tabs.insert(destination, self._tabs.pop(source))

        def _on_current_changed(self, index):
            tab = self._current()
            if tab is None:
                return
            self._stack.setCurrentWidget(tab.view)
            self._close_find()
            self.refresh_toolbar()
            if tab.view.url().toString() not in ("", HOME_URL):
                tab.view.setFocus()

        def _cycle_tab(self, step):
            if self._tabs:
                self._tab_bar.setCurrentIndex((self._tab_bar.currentIndex() + step) % len(self._tabs))

        # ---- page signals ----

        def _on_title_changed(self, tab, title):
            index = self._index_of(tab)
            if index < 0:
                return
            label = title or tab.view.url().toString() or "New Tab"
            if label == HOME_URL:
                label = "New Tab"
            self._tab_bar.setTabText(index, label)
            self._tab_bar.setTabToolTip(index, label)
            if not self._private:
                self._application.store.set_title(tab.view.url().toString(), title)
            if tab is self._current():
                self.setWindowTitle(window_title(title if label != "New Tab" else None, self._private))

        def _on_url_changed(self, tab, url):
            self._sync_background(tab, url.toString())
            if tab is self._current():
                self.refresh_toolbar()

        def _sync_background(self, tab, url):
            # Dark behind the empty new tab; white everywhere else, which is what pages expect.
            tab.page.setBackgroundColor(QColor(BACKGROUND if url in ("", HOME_URL) else "#ffffff"))

        def _set_tab_icon(self, tab, tab_icon):
            index = self._index_of(tab)
            if index >= 0:
                self._tab_bar.setTabIcon(index, tab_icon)

        def _on_load_started(self, tab):
            tab.loading = True
            if tab is self._current():
                self.refresh_toolbar()

        def _on_load_progress(self, tab, value):
            if tab is self._current():
                self._progress.setValue(value)
                self._progress.setVisible(tab.loading and value < 100)

        def _on_load_finished(self, tab, ok):
            tab.loading = False
            url = tab.view.url().toString()
            if ok and not self._private:
                self._application.store.record_visit(url, tab.view.title())
            if tab is self._current():
                self.refresh_toolbar()

        def _on_crashed(self, tab, status):
            if status == QWebEnginePage.RenderProcessTerminationStatus.NormalTerminationStatus:
                return
            index = self._index_of(tab)
            if index >= 0:
                self._tab_bar.setTabText(index, "Page crashed")
            if tab is self._current():
                self._show_bubble("This page crashed. Press Ctrl+R to load it again.")

        def _on_permission(self, tab, permission):
            name = permission.permissionType().name
            description = permission_description(name)
            if description is None:
                permission.deny()
                return
            host = permission.origin().host() or permission.origin().toString()
            box = QMessageBox(self)
            box.setWindowTitle("Permission")
            box.setText("{} wants to {}.".format(host, description))
            box.setInformativeText("CottonCandy remembers your answer until it quits.")
            allow = box.addButton("Allow", QMessageBox.ButtonRole.AcceptRole)
            block = box.addButton("Block", QMessageBox.ButtonRole.RejectRole)
            # Enter or Esc must never grant anything: only a click on Allow does.
            box.setDefaultButton(block)
            box.setEscapeButton(block)

            def answered(_result):
                if box.clickedButton() is allow:
                    permission.grant()
                else:
                    permission.deny()
                box.deleteLater()

            box.finished.connect(answered)
            box.open()

        def _on_certificate_error(self, error):
            # No way past a bad certificate: Chromium's error page explains it.
            error.rejectCertificate()

        def _on_fullscreen_requested(self, request):
            request.accept()
            self._set_fullscreen(request.toggleOn())

        def _set_fullscreen(self, on):
            self._chrome.setVisible(not on)
            if on:
                self.showFullScreen()
            else:
                self.showNormal()

        def _on_toggle_fullscreen(self):
            self._set_fullscreen(not self.isFullScreen())

        def _show_bubble(self, text):
            if not text:
                self._bubble.hide()
                return
            self._bubble.setText(text if len(text) <= 160 else text[:157] + "…")
            self._bubble.adjustSize()
            self._bubble.move(8, self._stack.height() - self._bubble.height() - 8)
            self._bubble.raise_()
            self._bubble.show()

        # ---- toolbar ----

        def refresh_toolbar(self):
            tab = self._current()
            if tab is None:
                return
            url = tab.view.url().toString()
            history = tab.view.history()
            self._back.setEnabled(history.canGoBack())
            self._forward.setEnabled(history.canGoForward())
            self._reload.setIcon(icon("x" if tab.loading else "reload"))
            self._reload.setToolTip("Stop (Esc)" if tab.loading else "Reload (Ctrl+R)")
            self._progress.setVisible(tab.loading)
            if not self._address.hasFocus() or not self._address.isModified():
                self.restore_address()
            scheme = url_scheme(url)
            if scheme == "https":
                self._security.setIcon(icon("lock", TEXT_SECONDARY))
                self._security.setToolTip("The connection to this site is encrypted")
            elif scheme == "http" and not is_local_host(tab.view.url().host()):
                self._security.setIcon(icon("warning", ERROR))
                self._security.setToolTip("Not secure: this page is sent unencrypted")
            else:
                self._security.setIcon(icon("search", TEXT_TERTIARY))
                self._security.setToolTip("")
            bookmarked = self._application.store.is_bookmarked(url)
            self._star.setEnabled(is_bookmarkable(url))
            self._star.setIcon(icon("star", accent_fg, filled=True) if bookmarked else icon("star"))
            self._star.setToolTip("Remove bookmark (Ctrl+D)" if bookmarked else "Bookmark this page (Ctrl+D)")
            title = tab.view.title()
            self.setWindowTitle(window_title(title if url not in ("", HOME_URL) else None, self._private))

        def restore_address(self):
            tab = self._current()
            url = tab.view.url().toString() if tab is not None else ""
            self._address.setText("" if url == HOME_URL else url)
            self._address.setModified(False)
            self._address.setCursorPosition(0)

        def _on_address_edited(self, text):
            self._suggestions.setStringList(self._application.store.suggestions(text))

        def _on_address_entered(self):
            # Enter fires this even with the suggestions open (with the picked one already in the field),
            # and then the completer's activated() for the same text, which _on_suggestion skips.
            self._entered = self._address.text()
            self._completer.popup().hide()
            self._navigate(self._entered)

        def _on_suggestion(self, text):
            if text == self._entered:
                self._entered = None
                return
            self._navigate(text)  # picked with the mouse

        def _navigate(self, text):
            url = resolve_input(text)
            tab = self._current()
            if url is None or tab is None:
                return
            self._address.setModified(False)
            tab.view.load(QUrl(url))
            tab.view.setFocus()

        def _on_focus_address(self):
            if self._chrome.isVisible():
                self._address.setFocus(Qt.FocusReason.ShortcutFocusReason)
                self._address.selectAll()

        def _on_reload(self):
            tab = self._current()
            if tab is None:
                return
            if tab.loading:
                tab.view.stop()
            else:
                tab.view.reload()

        def _current_view_call(self, name):
            tab = self._current()
            if tab is not None:
                getattr(tab.view, name)()

        def _on_new_tab(self):
            self.add_tab(HOME_URL)

        def _on_close_tab(self):
            self._close_tab_at(self._tab_bar.currentIndex())

        def _on_toggle_bookmark(self):
            tab = self._current()
            if tab is None:
                return
            url = tab.view.url().toString()
            store = self._application.store
            if store.is_bookmarked(url):
                store.remove_bookmark(url)
            elif store.add_bookmark(url, tab.view.title()):
                self._show_bubble("Bookmarked")
                QTimer.singleShot(1500, lambda: self._show_bubble(""))
            self.refresh_toolbar()

        def _show_library(self, kind):
            dialog = LibraryDialog(self, kind)
            dialog.setAttribute(Qt.WidgetAttribute.WA_DeleteOnClose)
            dialog.show()

        def _on_show_downloads(self):
            self._application.downloads.show_under(self._downloads_button)

        def _on_make_default(self):
            path = make_default_browser()
            QMessageBox.information(self, "Default Browser", "CottonCandy now opens web links.\n({})".format(path))

        def _zoom(self, step):
            tab = self._current()
            if tab is None:
                return
            factor = 1.0 if step is None else round(tab.view.zoomFactor() + step, 2)
            tab.view.setZoomFactor(min(5.0, max(0.25, factor)))

        def _on_devtools(self):
            tab = self._current()
            if tab is None:
                return
            if tab.devtools is None:
                view = QWebEngineView()
                view.setPage(QWebEnginePage(self._profile, view))
                tab.page.setDevToolsPage(view.page())
                view.setWindowTitle("Developer Tools — {}".format(tab.view.title() or tab.view.url().toString()))
                view.resize(1000, 640)
                view.setAttribute(Qt.WidgetAttribute.WA_DeleteOnClose)
                view.destroyed.connect(lambda *_args: setattr(tab, "devtools", None))
                tab.devtools = view
            tab.devtools.show()
            tab.devtools.raise_()

        # ---- find ----

        def _on_find(self):
            self._find_bar.show()
            self._find_entry.setFocus()
            self._find_entry.selectAll()

        def _find(self, backward):
            tab = self._current()
            if tab is None:
                return
            flags = QWebEnginePage.FindFlag.FindBackward if backward else QWebEnginePage.FindFlag(0)
            tab.page.findText(self._find_entry.text(), flags)
            if not self._find_entry.text():
                self._find_count.setText("")

        def _on_find_result(self, result):
            if self._find_entry.text():
                count = result.numberOfMatches()
                self._find_count.setText(
                    "{} of {}".format(result.activeMatch(), count) if count else "No matches"
                )

        def _close_find(self):
            if self._find_bar.isVisible():
                self._find_bar.hide()
                tab = self._current()
                if tab is not None:
                    tab.page.findText("")
                    tab.view.setFocus()

        # ---- lifetime ----

        def resizeEvent(self, event):
            super().resizeEvent(event)
            if self._bubble.isVisible():
                self._bubble.move(8, self._stack.height() - self._bubble.height() - 8)

        def closeEvent(self, event):
            if not self._closed:
                self._closed = True
                # Pages must go before their profile, or QtWebEngine leaks the profile's storage.
                while self._tabs:
                    self._dispose_tab(self._tabs.pop())
                self._application.window_closed(self)
            super().closeEvent(event)

    class CottonApplication(QApplication):
        def __init__(self):
            QApplication.setAttribute(Qt.ApplicationAttribute.AA_ShareOpenGLContexts)
            # Only the program name: Chromium reads switches like --no-sandbox from these arguments.
            super().__init__([sys.argv[0] if sys.argv else "cottoncandy"])
            self.setApplicationName(APP_NAME)
            self.setDesktopFileName(APP_ID)
            self.setStyle(QStyleFactory.create("Fusion"))
            self.setPalette(self._palette())
            self.setFont(QFont(DEFAULT_FONT, 10))
            self.setStyleSheet(stylesheet(accent))
            # Installed: the icon theme has it. From a checkout: the SVG next to this script.
            beside = os.path.join(os.path.dirname(os.path.realpath(__file__)), APP_ID + ".svg")
            self.setWindowIcon(QIcon.fromTheme(APP_ID, QIcon(beside) if os.path.exists(beside) else QIcon()))
            self.windows = []
            self.server = None
            self.store = None
            self.profile = None
            self.downloads = None

        def start(self):
            self.store = Store(os.path.join(data_directory(), "cottoncandy.db"))
            self.profile = QWebEngineProfile("cottoncandy", self)
            self.profile.setPersistentStoragePath(os.path.join(data_directory(), "profile"))
            self.profile.setCachePath(cache_directory())
            self.configure_profile(self.profile)
            self.downloads = DownloadsPanel()

        def configure_profile(self, profile):
            settings = profile.settings()
            attributes = QWebEngineSettings.WebAttribute
            settings.setAttribute(attributes.JavascriptCanOpenWindows, False)  # pop-ups need a click
            settings.setAttribute(attributes.LocalContentCanAccessRemoteUrls, False)
            settings.setAttribute(attributes.FullScreenSupportEnabled, True)
            settings.setAttribute(attributes.ScreenCaptureEnabled, True)  # still asks first
            # Qt drops unknown schemes that scripts start. Clicked ones reach CottonPage.acceptNavigationRequest,
            # which hands mailto: to the mail app and refuses the rest (returning False stops Qt's xdg-open).
            settings.setUnknownUrlSchemePolicy(
                QWebEngineSettings.UnknownUrlSchemePolicy.AllowUnknownUrlSchemesFromUserInteraction
            )
            profile.setPersistentPermissionsPolicy(QWebEngineProfile.PersistentPermissionsPolicy.StoreInMemory)
            profile.setSpellCheckEnabled(False)
            profile.downloadRequested.connect(lambda request: self.downloads.add(request))

        def _palette(self):
            palette = QPalette()
            roles = QPalette.ColorRole
            for role, value in (
                (roles.Window, WINDOW),
                (roles.WindowText, TEXT),
                (roles.Base, BACKGROUND),
                (roles.AlternateBase, PANEL),
                (roles.Text, TEXT),
                (roles.Button, WINDOW),
                (roles.ButtonText, TEXT_CONTROL),
                (roles.ToolTipBase, PANEL),
                (roles.ToolTipText, TEXT),
                (roles.PlaceholderText, TEXT_TERTIARY),
                (roles.Highlight, ACCENTS[accent]["fill"]),
                (roles.HighlightedText, "#ffffff"),
                (roles.Link, accent_fg),
            ):
                palette.setColor(role, QColor(value))
            palette.setColor(QPalette.ColorGroup.Disabled, roles.Text, QColor(TEXT_TERTIARY))
            palette.setColor(QPalette.ColorGroup.Disabled, roles.ButtonText, QColor(TEXT_TERTIARY))
            return palette

        def listen(self, path):
            self.server = QLocalServer(self)
            self.server.setSocketOptions(QLocalServer.SocketOption.UserAccessOption)
            QLocalServer.removeServer(path)
            if not self.server.listen(path):
                print("cottoncandy: {}; links from other apps open new copies".format(self.server.errorString()), file=sys.stderr)
                return
            self.server.newConnection.connect(self._on_connection)

        def _on_connection(self):
            while self.server.hasPendingConnections():
                socket = self.server.nextPendingConnection()
                buffer = bytearray()

                def read(socket=socket, buffer=buffer):
                    buffer.extend(bytes(socket.readAll()))
                    if len(buffer) > MAX_REQUEST_BYTES:
                        socket.abort()

                def finished(socket=socket, buffer=buffer):
                    read()
                    request = decode_request(bytes(buffer))
                    socket.deleteLater()
                    if request is not None:
                        self.handle(request)

                socket.readyRead.connect(read)
                socket.disconnected.connect(finished)

        def handle(self, request):
            urls = [url for url in (argument_to_url(item, request["cwd"]) for item in request["urls"]) if url]
            refused = len(request["urls"]) - len(urls)
            if refused:
                print("cottoncandy: refused {} address(es) with an unsafe scheme".format(refused), file=sys.stderr)
            target = None
            if not request["new_window"]:
                matching = [window for window in self.windows if window.private == request["private"]]
                active = self.activeWindow()
                target = active if active in matching else (matching[-1] if matching else None)
            if target is None:
                self.create_window(urls, private=request["private"])
                return
            for url in urls or [HOME_URL]:
                target.add_tab(url)
            target.show()
            target.raise_()
            target.activateWindow()

        def create_window(self, urls=None, private=False):
            window = CottonWindow(self, private=private)
            self.windows.append(window)
            for url in urls or [HOME_URL]:
                window.add_tab(url, focus=False)
            window._tab_bar.setCurrentIndex(0)
            window.show()
            return window

        def window_closed(self, window):
            if window in self.windows:
                self.windows.remove(window)

        def clear_history(self):
            self.store.clear_history()
            self.profile.clearAllVisitedLinks()
            for window in self.windows:
                window.refresh_toolbar()

    socket_path = runtime_socket_path()
    request = encode_request(options.urls, os.getcwd(), options.new_window, options.private)
    app = CottonApplication()

    # A browser is already running: hand it the addresses and let it open them.
    client = QLocalSocket()
    client.connectToServer(socket_path)
    if client.waitForConnected(500):
        client.write(request)
        client.waitForBytesWritten(1000)
        client.disconnectFromServer()
        if client.state() != QLocalSocket.LocalSocketState.UnconnectedState:
            client.waitForDisconnected(1000)
        return 0

    app.start()
    app.listen(socket_path)
    app.handle(decode_request(request))
    status = app.exec()
    # Delete the closed windows' pages before the profiles they belong to.
    QApplication.sendPostedEvents(None, QEvent.Type.DeferredDelete)
    app.store.close()
    return status


if __name__ == "__main__":
    sys.exit(main())
