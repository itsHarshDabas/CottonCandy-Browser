        def eventFilter(self, watched, event):
            if watched is self._find_entry and event.type() == QEvent.Type.KeyPress:
                if event.key() == Qt.Key.Key_Escape:
                    self._close_find()
                    return True
                if event.key() in (Qt.Key.Key_Return, Qt.Key.Key_Enter) and event.modifiers() & Qt.KeyboardModifier.ShiftModifier:
                    self._find(True)
                    return True
            return super().eventFilter(watched, event)

        # ---- tabs ----

        def add_tab(self, url=HOME_URL, focus=True, after=None):
            tab = CottonTab(self, self._profile)
            index = len(self._tabs)
            if after is not None:
                for position, existing in enumerate(self._tabs):
                    if existing.page is after:
                        index = position + 1
            self._tabs.insert(index, tab)
            self._stack.addWidget(tab.view)
            self._tab_bar.insertTab(index, "")
            self._tab_bar.setTabButton(index, QTabBar.ButtonPosition.LeftSide, tab.label)
            self._tab_bar.setTabButton(index, QTabBar.ButtonPosition.RightSide, tab.buttons)
            self._connect_tab(tab)
            if url:
                tab.view.load(QUrl(url))
            self._relayout_tabs()
            if focus or len(self._tabs) == 1:
                self._tab_bar.setCurrentIndex(index)
                if not url or url == HOME_URL:
                    QTimer.singleShot(0, self._on_focus_address)
                else:
                    tab.view.setFocus()
            self.refresh_tab_buttons()
            return tab

        def _connect_tab(self, tab):
            view, page = tab.view, tab.page
            view.titleChanged.connect(lambda title: self._on_title_changed(tab, title))
            view.urlChanged.connect(lambda url: self._on_url_changed(tab, url))
            view.iconChanged.connect(lambda tab_icon: self._on_icon_changed(tab, tab_icon))
            view.loadStarted.connect(lambda: self._on_load_started(tab))
            view.loadProgress.connect(lambda value: self._on_load_progress(tab, value))
            view.loadFinished.connect(lambda ok: self._on_load_finished(tab, ok))
            view.renderProcessTerminated.connect(lambda status, code: self._on_crashed(tab, status))
            page.loadingChanged.connect(lambda info: self._on_loading_changed(tab, info))
            page.linkHovered.connect(self._show_bubble)
            page.permissionRequested.connect(lambda permission: self._on_permission(tab, permission))
            page.certificateError.connect(lambda error: error.rejectCertificate())  # never a way past it
            page.fullScreenRequested.connect(self._on_fullscreen_requested)
            page.findTextFinished.connect(self._on_find_result)
            page.windowCloseRequested.connect(lambda: self.close_tab(tab))
            page.recentlyAudibleChanged.connect(lambda audible: self._on_audible(tab, audible))
            page.audioMutedChanged.connect(lambda _muted: self.refresh_tab_buttons())

        def _index_of(self, tab):
            return self._tabs.index(tab) if tab in self._tabs else -1

        def _current(self):
            return self.tab_at(self._tab_bar.currentIndex())

        def close_tab(self, tab):
            index = self._index_of(tab)
            if index >= 0:
                self.close_tab_at(index)

        def close_tab_at(self, index):
            if not 0 <= index < len(self._tabs):
                return
            tab = self._tabs.pop(index)
            url = tab.url()
            if is_web_url(url) and not self._private:
                self._application.remember_closed(url, tab.view.title())
            self._tab_bar.removeTab(index)
            self._dispose_tab(tab)
            if not self._tabs:
                self.close()
                return
            self._relayout_tabs()
            self.refresh_tab_buttons()

        def _dispose_tab(self, tab):
            for permission in tab.permissions:
                if permission.isValid():
                    permission.deny()
            tab.permissions.clear()
            tab.buttons.deleteLater()
            if tab.devtools is not None:
                tab.devtools.close()
            self._stack.removeWidget(tab.view)
            tab.view.setParent(None)
            tab.view.deleteLater()  # its page is a child, so it goes too

        def _on_tab_moved(self, source, destination):
            self._tabs.insert(destination, self._tabs.pop(source))

        def _on_current_changed(self, index):
            tab = self._current()
            if tab is None:
                return
            self._stack.setCurrentWidget(tab.view)
            self._close_find()
            self.hide_overlays()
            self._relayout_tabs()
            self.refresh_tab_buttons()
            self.refresh_toolbar()
            self._show_pending_permission()

        def _cycle_tab(self, step):
            if self._tabs:
                self._tab_bar.setCurrentIndex((self._tab_bar.currentIndex() + step) % len(self._tabs))

        def _relayout_tabs(self):
            """Shrink inactive tabs to their icon when there isn't room for every title; pinned tabs always are."""
            available = max(200, self._tab_row.width() - 180)
            normal = [t for t in self._tabs if not t.pinned]
            crowded = len(normal) * 204 + (len(self._tabs) - len(normal)) * 40 > available
            current = self._current()
            changed = False
            for index, tab in enumerate(self._tabs):
                icon_only = tab.pinned or (crowded and tab is not current)
                if icon_only != tab.icon_only:
                    tab.icon_only = icon_only
                    changed = True
                self._sync_tab_text(index, tab)
            if changed:
                for index in range(len(self._tabs)):
                    self._tab_bar.setTabText(index, " " if self._tabs[index].icon_only else "")  # relayout
            self.refresh_tab_buttons()

        def _sync_tab_text(self, index, tab):
            title = "Page crashed" if tab.crashed else (tab.view.title() or "New Tab")
            if url_parts(tab.url())["kind"] == "empty":
                title = "New Tab"
            tab.title = title
            self._tab_bar.setTabToolTip(index, title)

        def refresh_tab_buttons(self):
            current = self._current()
            for index, tab in enumerate(self._tabs):
                buttons = tab.buttons
                muted = tab.page.isAudioMuted()
                show_audio = (tab.audible or muted) and not tab.icon_only
                buttons.audio.setVisible(show_audio)
                if show_audio:
                    set_icon(buttons.audio, "mute" if muted else "speaker", "text_secondary" if muted else "accent_text")
                    buttons.audio.setToolTip("Unmute tab" if muted else "Mute tab")
                close_visible = not tab.icon_only and (tab is current or index == self._tab_bar.hovered)
                buttons.close.setVisible(close_visible)
                state = "active" if tab is current else ("hover" if index == self._tab_bar.hovered else "")
                # 200 px tabs: 8 padding, label, the audio and close buttons, 4 padding.
                width = 16 if tab.icon_only else 200 - 12 - 20 - (20 if show_audio else 0)
                tab.label.set_content(self._tab_icon(tab), getattr(tab, "title", "New Tab"), state, width)

        def _tab_icon(self, tab):
            if tab.loading:
                return spinner_frame(self._application.spin_step)
            if tab.crashed:
                return icon("alert", "error")
            if url_parts(tab.url())["kind"] == "empty":
                return icon("search", "text_secondary")
            if not tab.favicon.isNull() and tab.favicon_host == _host(tab.url()):
                return tab.favicon
            known = self._application.known_icon(tab.url())  # the site's icon from an earlier visit
            return known if known is not None else icon("globe", "text_secondary")

        def tab_menu(self, index, position):
            tab = self.tab_at(index)
            if tab is None:
                return
            menu = QMenu(self)
            menu.addAction("Reload", tab.view.reload)
            menu.addAction("Duplicate", lambda: self.add_tab(tab.url(), after=tab.page))
            menu.addAction("Unpin" if tab.pinned else "Pin", lambda: self._toggle_pin(tab))
            menu.addAction("Unmute" if tab.page.isAudioMuted() else "Mute", lambda: self.toggle_mute(tab))
            menu.addSeparator()
            menu.addAction("Close", lambda: self.close_tab(tab))
            menu.addAction("Close other tabs", lambda: self._close_others(tab))
            reopen = menu.addAction("Reopen closed tab", self._reopen_closed)
            reopen.setEnabled(bool(self._application.recently_closed))
            menu.exec(position)

        def _toggle_pin(self, tab):
            tab.pinned = not tab.pinned
            index = self._index_of(tab)
            target = len([t for t in self._tabs if t.pinned and t is not tab]) if tab.pinned else len([t for t in self._tabs if t.pinned])
            if index != target:
                self._tab_bar.moveTab(index, target)
            self._relayout_tabs()

        def toggle_mute(self, tab):
            tab.page.setAudioMuted(not tab.page.isAudioMuted())
            self.refresh_tab_buttons()

        def _close_others(self, keep):
            for tab in [t for t in self._tabs if t is not keep and not t.pinned]:
                self.close_tab(tab)

        def _reopen_closed(self):
            if self._application.recently_closed:
                url, _title = self._application.recently_closed.pop(0)
                self.add_tab(url)

        def _fill_tab_list(self):
            self._tab_list_menu.clear()
            for index, tab in enumerate(self._tabs):
                title = self._tab_bar.tabToolTip(index)
                action = self._tab_list_menu.addAction(self._tab_icon(tab), title)
                action.setCheckable(True)
                action.setChecked(tab is self._current())
                action.triggered.connect(lambda _checked=False, i=index: self._tab_bar.setCurrentIndex(i))

        # ---- page signals ----

        def _on_title_changed(self, tab, title):
            index = self._index_of(tab)
            if index < 0:
                return
            self._sync_tab_text(index, tab)
            if not self._private and tab.error_url is None:
                self._application.store.set_title(tab.url(), title)
            if tab is self._current():
                self._update_window_title(tab)
                self._grace.refresh()

        def _update_window_title(self, tab):
            empty = url_parts(tab.url())["kind"] == "empty"
            self.setWindowTitle(window_title(None if empty else tab.view.title(), self._private))

        def _on_url_changed(self, tab, url):
            if tab is self._current():
                self.refresh_toolbar()
            index = self._index_of(tab)
            if index >= 0:
                self._sync_tab_text(index, tab)

        def _on_icon_changed(self, tab, tab_icon):
            url = tab.url()
            host = _host(url)
            if tab_icon.isNull():
                # Chromium clears the icon while it loads; keep the site's icon unless the site changed.
                if host != tab.favicon_host:
                    tab.favicon, tab.favicon_host = QIcon(), host
            else:
                tab.favicon, tab.favicon_host = tab_icon, host
                if is_web_url(url) and not self._private:
                    self._application.store.set_icon(url, png_bytes(tab_icon))
                    self._application.forget_icon(url)
            self.refresh_tab_buttons()

        def _on_load_started(self, tab):
            tab.loading = True
            tab.crashed = False
            self._application.ensure_spinner()
            if tab is self._current():
                self.refresh_toolbar()
            self.refresh_tab_buttons()

        def _on_load_progress(self, tab, value):
            if tab is self._current():
                self._progress.setValue(value)
                self._progress.setVisible(tab.loading and value < 100)

        def _on_load_finished(self, tab, ok):
            tab.loading = False
            url = tab.url()
            if ok and not self._private and tab.error_url != url:
                self._application.store.record_visit(url, tab.view.title())
            if tab is self._current():
                self.refresh_toolbar()
            self.refresh_tab_buttons()

        def _on_loading_changed(self, tab, info):
            status = QWebEngineLoadingInfo.LoadStatus
            url = info.url().toString()
            if info.status() == status.LoadStartedStatus and url == tab.error_url:
                tab.error_url = None  # trying the failed page again
            if info.status() != status.LoadFailedStatus or info.errorCode() == -3 or url_scheme(url) not in ("http", "https", "file"):
                return  # -3 is ERR_ABORTED: the user stopped it or went somewhere else
            kind = error_kind(info.errorDomain().name, info.errorCode())
            # Replace Chromium's error page with ours. setHtml with the failed URL keeps that URL in the
            # address bar and in history, so Back and Reload behave; the page itself runs no code.
            tab.error_url = url
            tab.error_text = info.errorString() or "Error {}".format(info.errorCode())
            tab.page.error_page_pending = True
            tab.page.setHtml(error_html(tok(), kind, url, tab.error_text, ai=theme["ai"]), info.url())
            if tab is self._current():
                self._grace.refresh()

        def _on_crashed(self, tab, status):
            if status == QWebEnginePage.RenderProcessTerminationStatus.NormalTerminationStatus:
                return
            tab.crashed = True
            tab.loading = False
            index = self._index_of(tab)
            if index >= 0:
                self._sync_tab_text(index, tab)
            self.refresh_tab_buttons()
            if tab is self._current():
                self._show_bubble("This page crashed. Press Ctrl+R to load it again.")

        def _on_audible(self, tab, audible):
            tab.audible = audible
            self.refresh_tab_buttons()

        # ---- Grace (AI on only): the side panel; every run starts from a click ----

        def apply_ai(self):
            """Follow GraceOS's AI switch: with AI off, every Grace touch disappears and nothing else moves."""
            on = theme["ai"]
            self._sparkle.setVisible(on)
            self._grace_action.setVisible(on)
            self._grace_action.setEnabled(on)
            if not on and self._grace.isVisible():
                self._grace.close_panel()
            self._sparkle.setChecked(self._grace.isVisible())

        def toggle_grace(self):
            if self._grace.isVisible():
                self._grace.close_panel()
            elif theme["ai"]:
                self.hide_overlays()
                self._grace.open()
            self._sparkle.setChecked(self._grace.isVisible())

        def ask_grace(self, question):
            """A question typed in the address bar: no page text goes with it."""
            if not theme["ai"]:
                return
            if not self._grace.isVisible():
                self.toggle_grace()
            self._grace.run("question", question)

        def explain_error(self, tab):
            if not theme["ai"] or tab is not self._current():
                return
            if not self._grace.isVisible():
                self.toggle_grace()
            self._grace.run("error")

        # ---- permissions: a card anchored to the site icon, never allowed by default ----

        def _on_permission(self, tab, permission):
            if permission_description(permission.permissionType().name) is None:
                permission.deny()
                return
            tab.permissions.append(permission)
            if tab is self._current():
                self._show_pending_permission()

        def _show_pending_permission(self):
            tab = self._current()
            if tab is None:
                return
            tab.permissions = [p for p in tab.permissions if p.isValid()]
            if not tab.permissions:
                if getattr(self._site_card, "kind", None) == "permission":
                    self._site_card.hide()
                return
            permission = tab.permissions[0]
            name = permission.permissionType().name
            origin = permission.origin()
            card = self._site_card
            card.kind = "permission"
            layout = self._card_layout(card)
            head = QHBoxLayout()
            head.setSpacing(10)
            badge = QFrame()
            badge.setObjectName("tile")
            badge.setFixedSize(30, 30)
            badge_row = QHBoxLayout(badge)
            badge_row.setContentsMargins(8, 8, 8, 8)
            badge_row.addWidget(icon_label(icon(PERMISSION_ICONS.get(name, "info")), 14))
            head.addWidget(badge, 0, Qt.AlignmentFlag.AlignTop)
            text = QVBoxLayout()
            text.setSpacing(2)
            text.addWidget(label("{} wants to {}".format(origin.host() or origin.toString(), permission_description(name)), "title", wrap=True))
            text.addWidget(label("Your answer lasts for this tab. Other tabs ask again.", "secondary", wrap=True))
            head.addLayout(text, 1)
            layout.addLayout(head)
            details = QFrame()
            details.setObjectName("details")
            grid = QGridLayout(details)
            grid.setContentsMargins(10, 8, 10, 8)
            grid.setHorizontalSpacing(12)
            for row_index, (key, value) in enumerate((("Asked by", origin.toString()), ("Tab", tab.view.title() or tab.url()))):
                grid.addWidget(label(key, "secondary"), row_index, 0)
                value_label = label(value, wrap=True)
                grid.addWidget(value_label, row_index, 1)
            details.hide()
            layout.addWidget(details)
            buttons = QHBoxLayout()
            buttons.setSpacing(6)
            allow = QPushButton("Allow once")
            allow.setObjectName("primary")
            deny = QPushButton("Deny")
            more = QPushButton("Details")
            more.setObjectName("ghost")
            allow.clicked.connect(lambda: self._answer_permission(tab, permission, True))
            deny.clicked.connect(lambda: self._answer_permission(tab, permission, False))
            more.clicked.connect(lambda: (details.setVisible(not details.isVisible()), more.setText("Hide details" if details.isVisible() else "Details"), card.adjustSize()))
            for button in (allow, deny, more):
                buttons.addWidget(button)
            buttons.addStretch(1)
            layout.addLayout(buttons)
            card.show_at(self._address.site)
            deny.setFocus()  # Enter or Esc on the card denies; only a click on Allow allows

        def _answer_permission(self, tab, permission, allow):
            if permission in tab.permissions:
                tab.permissions.remove(permission)
            if permission.isValid():
                permission.grant() if allow else permission.deny()
            self._site_card.hide()
            self._show_pending_permission()

        def _card_layout(self, card):
            layout = card.layout()
            if layout is None:
                layout = QVBoxLayout(card)
                layout.setContentsMargins(14, 14, 14, 14)
                layout.setSpacing(10)
            clear_layout(layout)
            return layout

        def toggle_site_info(self):
            card = self._site_card
            if card.isVisible():
                card.hide()
                return
            tab = self._current()
            if tab is None:
                return
            if tab.permissions:
                self._show_pending_permission()
                return
            parts = url_parts(tab.url())
            if parts["kind"] == "empty":
                self._on_focus_address()
                return
            card.kind = "info"
            layout = self._card_layout(card)
            sentences = {
                "secure": ("lock", "Connection is secure. The site’s certificate is valid."),
                "insecure": ("warning", "Not secure: this page is sent unencrypted. Don’t enter passwords or card numbers."),
                "local": ("info", "A page served from this computer. It isn’t encrypted, but it doesn’t leave the computer."),
                "file": ("file", "A file on this computer."),
            }
            name, sentence = sentences.get(parts["kind"], ("info", "A CottonCandy page."))
            head = QHBoxLayout()
            head.setSpacing(10)
            head.addWidget(icon_label(icon(name, "error" if parts["kind"] == "insecure" else "text_secondary")), 0, Qt.AlignmentFlag.AlignTop)
            text = QVBoxLayout()
            text.setSpacing(2)
            text.addWidget(label(parts["host"] if parts["kind"] != "file" else "Local file", "title"))
            text.addWidget(label(sentence, "secondary", wrap=True))
            head.addLayout(text, 1)
            layout.addLayout(head)
            layout.addWidget(label("Camera, microphone, location, screen sharing and notifications: this site has to ask every time, and nothing is allowed until you click Allow once.", "secondary", wrap=True))
            card.show_at(self._address.site)

        # ---- downloads ----

        def toggle_downloads(self):
            card = self._downloads_card
            if card.isVisible():
                card.hide()
                return
            self.refresh_downloads()
            card.show_at(self._downloads_button, align="right")

        def refresh_downloads(self):
            card = self._downloads_card
            layout = self._card_layout(card)
            layout.setContentsMargins(6, 6, 6, 6)
            layout.setSpacing(0)
            header = QHBoxLayout()
            header.setContentsMargins(10, 4, 4, 6)
            header.addWidget(label("Downloads", "title"), 1)
            folder = QPushButton("Open folder")
            folder.setObjectName("ghost")
            folder.clicked.connect(lambda: QDesktopServices.openUrl(QUrl.fromLocalFile(self._application.downloads_directory())))
            header.addWidget(folder)
            layout.addLayout(header)
            downloads = self._application.downloads
            if not downloads:
                empty = label("No downloads yet", "secondary")
                empty.setAlignment(Qt.AlignmentFlag.AlignCenter)
                empty.setMinimumHeight(56)
                layout.addWidget(empty)
            for download in downloads[:8]:
                layout.addWidget(DownloadRow(self, download))
            card.adjustSize()

        def retry_download(self, download):
            tab = self._current()
            if tab is not None:
                tab.page.download(download.request.url(), os.path.basename(download.path))

        # ---- address bar and suggestions ----

        def refresh_toolbar(self):
            tab = self._current()
            if tab is None:
                return
            url = tab.url()
            history = tab.view.history()
            self._back.setEnabled(history.canGoBack())
            self._forward.setEnabled(history.canGoForward())
            set_icon(self._reload, "x" if tab.loading else "reload")
            self._reload.setToolTip("Stop (Esc)" if tab.loading else "Reload (Ctrl+R)")
            self._progress.setVisible(tab.loading)
            self._address.set_url(url, self._application.store.is_bookmarked(url))
            self._update_window_title(tab)
            self._place_progress()
            self._grace.refresh()

        def _place_progress(self):
            self._progress.setGeometry(0, self._toolbar.geometry().bottom() - 1, self.centralWidget().width(), 2)
            self._progress.raise_()

        def update_suggestions(self, text):
            store = self._application.store
            open_tabs = [(t.url(), t.view.title()) for t in self._tabs if t is not self._current()]
            self._suggestions = build_suggestions(text, open_tabs, store.bookmark_matches(text), store.history_matches(text), ai=theme["ai"])
            self._selected = -1
            layout = self._dropdown_layout
            clear_layout(layout)
            if not self._suggestions:
                self._dropdown.hide()
                return
            self._rows = []
            group = None
            for index, entry in enumerate(self._suggestions):
                if entry["group"] != group:
                    group = entry["group"]
                    layout.addWidget(label(group, "group"))
                title = entry["title"]
                if entry["kind"] == "ask":
                    row_icon, sub, title = icon("spark", "accent_text"), "Local AI · on this device", "Ask Grace about “{}”".format(entry["title"])
                elif entry["kind"] == "search":
                    row_icon, sub = icon("search", "text_secondary"), "DuckDuckGo"
                elif entry["kind"] == "address":
                    row_icon, sub = icon("globe", "text_secondary"), "Open address"
                else:
                    row_icon = self._icon_from_png(store.icon_for(entry["url"])) or icon("globe", "text_secondary")
                    sub = url_parts(entry["url"])["host"]
                row = Row(row_icon, title, sub, "Switch to tab" if entry["kind"] == "tab" else "",
                          on_click=lambda e=entry: self.open_suggestion(e))
                layout.addWidget(row)
                self._rows.append(row)
            self._dropdown.setFixedWidth(self._address.width() + 2)
            self._dropdown.show_at(self._address)
            self._address.edit.setFocus()

        def _icon_from_png(self, png):
            if not png:
                return None
            pixmap = QPixmap()
            pixmap.loadFromData(png, "PNG")
            return QIcon(pixmap) if not pixmap.isNull() else None

        def move_suggestion(self, step):
            if not self._dropdown.isVisible() or not self._suggestions:
                return
            self._selected = max(-1, min(len(self._suggestions) - 1, self._selected + step))
            for index, row in enumerate(self._rows):
                row.set_selected(index == self._selected)

        def hide_suggestions(self):
            self._dropdown.hide()
            self._selected = -1

        def address_entered(self):
            if self._dropdown.isVisible() and self._selected >= 0:
                self.open_suggestion(self._suggestions[self._selected])
                return
            self._navigate(self._address.edit.text())

        def open_suggestion(self, entry):
            if entry["kind"] == "ask":
                self._address.edit.setModified(False)
                self._address.finish()
                self.ask_grace(entry["title"])
                return
            if entry["kind"] == "tab":
                for index, tab in enumerate(self._tabs):
                    if tab.url() == entry["url"]:
                        self._address.finish()
                        self._tab_bar.setCurrentIndex(index)
                        return
            self._load(entry["url"])

        def _navigate(self, text):
            url = resolve_input(text)
            if url is not None:
                self._load(url)

        def _load(self, url):
            tab = self._current()
            if tab is None:
                return
            self._address.edit.setModified(False)
            self._address.finish()
            tab.view.load(QUrl(url))
            tab.view.setFocus()

        def focus_page(self):
            tab = self._current()
            if tab is not None:
                tab.view.setFocus()

        def _on_focus_address(self):
            if self._toolbar.isVisible():
                self._address.begin(select_all=True)

        def toggle_bookmark(self):
            tab = self._current()
            if tab is None:
                return
            url = tab.url()
            store = self._application.store
            if store.is_bookmarked(url):
                store.remove_bookmark(url)
            elif store.add_bookmark(url, tab.view.title()):
                self._show_bubble("Bookmarked")
                QTimer.singleShot(1500, lambda: self._show_bubble(""))
            self.refresh_toolbar()

        # ---- misc actions ----

        def _on_reload(self):
            tab = self._current()
            if tab is None:
                return
            if tab.loading:
                tab.view.stop()
            else:
                tab.view.reload()

        def _current_view_call(self, name):
            tab = self._current()
            if tab is not None:
                getattr(tab.view, name)()

        def _on_new_tab(self):
            self.add_tab(HOME_URL)

        def _on_close_tab(self):
            self.close_tab_at(self._tab_bar.currentIndex())

        def _show_library(self, kind):
            dialog = LibraryDialog(self, kind)
            dialog.setAttribute(Qt.WidgetAttribute.WA_DeleteOnClose)
            dialog.show()

        def _on_make_default(self):
            path = make_default_browser()
            QMessageBox.information(self, "Default Browser", "CottonCandy now opens web links.\n({})".format(path))

        def _on_clear_data(self):
            answer = QMessageBox.question(
                self, "Clear Cookies and Cache",
                "Sign out of every site and delete cached files? History, bookmarks and downloads stay.")
            if answer == QMessageBox.StandardButton.Yes:
                self._profile.cookieStore().deleteAllCookies()
                self._profile.clearHttpCache()
                self._show_bubble("Cookies and cache cleared")
                QTimer.singleShot(2000, lambda: self._show_bubble(""))

        def _zoom(self, step):
            tab = self._current()
            if tab is None:
                return
            factor = 1.0 if step is None else round(tab.view.zoomFactor() + step, 2)
            tab.view.setZoomFactor(min(5.0, max(0.25, factor)))
            self._sync_zoom_label()

        def _sync_zoom_label(self):
            tab = self._current()
            if tab is not None:
                self._zoom_value.setText("{}%".format(round(tab.view.zoomFactor() * 100)))

        def _on_devtools(self):
            tab = self._current()
            if tab is None:
                return
            if tab.devtools is None:
                view = QWebEngineView()
                view.setPage(QWebEnginePage(self._profile, view))
                tab.page.setDevToolsPage(view.page())
                view.setWindowTitle("Developer Tools — {}".format(tab.view.title() or tab.url()))
                view.resize(1000, 640)
                view.setAttribute(Qt.WidgetAttribute.WA_DeleteOnClose)
                view.destroyed.connect(lambda *_args: setattr(tab, "devtools", None))
                tab.devtools = view
            tab.devtools.show()
            tab.devtools.raise_()

        def _on_fullscreen_requested(self, request):
            request.accept()
            self._set_fullscreen(request.toggleOn())

        def _set_fullscreen(self, on):
            self._tab_row.setVisible(not on)
            self._toolbar.setVisible(not on)
            self.hide_overlays()
            if on:
                self.showFullScreen()
            else:
                self.showNormal()

        def _on_toggle_fullscreen(self):
            self._set_fullscreen(not self.isFullScreen())

        def toggle_maximized(self):
            self.showNormal() if self.isMaximized() else self.showMaximized()

        def _show_bubble(self, text):
            if not text:
                self._bubble.hide()
                return
            self._bubble.setText(text if len(text) <= 160 else text[:157] + "…")
            self._bubble.adjustSize()
            self._bubble.move(8, self._stack.height() - self._bubble.height() - 8)
            self._bubble.raise_()
            self._bubble.show()

        # ---- find ----

        def _on_find(self):
            self._find_bar.show()
            self._find_entry.setFocus()
            self._find_entry.selectAll()

        def _find(self, backward):
            tab = self._current()
            if tab is None:
                return
            flags = QWebEnginePage.FindFlag(0)
            if backward:
                flags |= QWebEnginePage.FindFlag.FindBackward
            if self._match_case.isChecked():
                flags |= QWebEnginePage.FindFlag.FindCaseSensitively
            tab.page.findText(self._find_entry.text(), flags)
            if not self._find_entry.text():
                self._set_find_count("", False)

        def _set_find_count(self, text, none):
            self._find_count.setText(text)
            self._find_count.setProperty("none", none)
            repolish(self._find_count)

        def _on_find_result(self, result):
            if self._find_entry.text():
                count = result.numberOfMatches()
                self._set_find_count("{} of {}".format(result.activeMatch(), count) if count else "No matches", not count)

        def _close_find(self):
            if self._find_bar.isVisible():
                self._find_bar.hide()
                tab = self._current()
                if tab is not None:
                    tab.page.findText("")
                    tab.view.setFocus()

        # ---- overlays, theme, lifetime ----

        def permission_card_open(self):
            return self._site_card.isVisible() and getattr(self._site_card, "kind", None) == "permission"

        def sync_scrim(self):
            """Show the click-catching scrim under open popovers (not for a permission card, which must be answered)."""
            if not hasattr(self, "_scrim"):
                return
            closable = [o for o in self._overlays if o.isVisible() and getattr(o, "kind", None) != "permission"]
            self._escape.setEnabled(any(o.isVisible() for o in self._overlays))
            if closable:
                self._scrim.setGeometry(self.centralWidget().rect())
                self._scrim.show()
                self._scrim.raise_()
                for overlay in self._overlays:
                    if overlay.isVisible():
                        overlay.raise_()
            else:
                self._scrim.hide()

        def _place_grips(self):
            width, height = self.centralWidget().width(), self.centralWidget().height()
            size, corner = 4, 12
            geometry = [(0, corner, size, height - 2 * corner), (width - size, corner, size, height - 2 * corner),
                        (corner, 0, width - 2 * corner, size), (corner, height - size, width - 2 * corner, size),
                        (0, height - corner, corner, corner), (width - corner, height - corner, corner, corner)]
            resizable = not (self.isMaximized() or self.isFullScreen())
            for grip, rect in zip(self._grips, geometry):
                grip.setGeometry(*rect)
                grip.setVisible(resizable)
                grip.raise_()

        def hide_overlays(self):
            """Hide every popover without answering anything (switching tabs, resizing)."""
            for overlay in self._overlays:
                overlay.hide()

        def dismiss_overlays(self, escape=False):
            """A click outside closes popovers. A permission card only goes away when answered; Esc answers Deny."""
            for overlay in self._overlays:
                if not overlay.isVisible():
                    continue
                if overlay is self._site_card and getattr(overlay, "kind", None) == "permission":
                    tab = self._current()
                    if escape and tab is not None and tab.permissions:
                        self._answer_permission(tab, tab.permissions[0], False)
                    continue
                overlay.hide()
            if self._address.editing:
                self._address.cancel()

        def any_overlay(self):
            return any(overlay.isVisible() for overlay in self._overlays)

        def apply_theme(self):
            for overlay in self._overlays:
                shadow(overlay)
            self._lights.update()
            self.refresh_tab_buttons()
            self.refresh_toolbar()
            for tab in self._tabs:
                if url_scheme(tab.url()) == INTERNAL_SCHEME:
                    tab.view.reload()
                elif tab.error_url and tab.error_url == tab.url():
                    tab.view.load(QUrl(tab.error_url))
            if self._downloads_card.isVisible():
                self.refresh_downloads()
            self._grace.apply_theme()
            self.apply_ai()

        def changeEvent(self, event):
            if event.type() == QEvent.Type.ActivationChange:
                self._lights.update()
            super().changeEvent(event)

        def resizeEvent(self, event):
            super().resizeEvent(event)
            self._relayout_tabs()
            self._place_progress()
            self._place_grips()
            self.hide_overlays()
            QTimer.singleShot(0, self._show_pending_permission)
            if self._bubble.isVisible():
                self._bubble.move(8, self._stack.height() - self._bubble.height() - 8)

        def closeEvent(self, event):
            if not self._closed:
                self._closed = True
                self._grace.stop()
                # Pages must go before their profile, or QtWebEngine leaks the profile's storage.
                while self._tabs:
                    self._dispose_tab(self._tabs.pop())
                self._application.window_closed(self)
            super().closeEvent(event)

    class CottonApplication(QApplication):
        def __init__(self):
            QApplication.setAttribute(Qt.ApplicationAttribute.AA_ShareOpenGLContexts)
            # Only the program name: Chromium reads switches like --no-sandbox from these arguments.
            super().__init__([sys.argv[0] if sys.argv else "cottoncandy"])
            self.setApplicationName(APP_NAME)
            self.setDesktopFileName(APP_ID)
            self.setStyle(QStyleFactory.create("Fusion"))
            self.setFont(QFont(DEFAULT_FONT, 10))
            # Installed: the icon theme has it. From a checkout: the SVG next to this script.
            beside = os.path.join(os.path.dirname(os.path.realpath(__file__)), APP_ID + ".svg")
            self.setWindowIcon(QIcon.fromTheme(APP_ID, QIcon(beside) if os.path.exists(beside) else QIcon()))
            self.windows = []
            self.server = None
            self.store = None
            self.profile = None
            self.downloads = []
            self.recently_closed = []
            self.spin_step = 0
            self._handlers = []
            self._icons = {}
            self._taken_paths = set()
            self._spinner = QTimer(self)
            self._spinner.setInterval(80)
            self._spinner.timeout.connect(self._spin)
            self._download_timer = QTimer(self)
            self._download_timer.setInterval(500)
            self._download_timer.timeout.connect(self._update_download_buttons)
            self.apply_theme(initial=True)

        def start(self):
            self.store = Store(os.path.join(data_directory(), "cottoncandy.db"))
            self.profile = QWebEngineProfile("cottoncandy", self)
            self.profile.setPersistentStoragePath(os.path.join(data_directory(), "profile"))
            self.profile.setCachePath(cache_directory())
            self.configure_profile(self.profile, private=False)
            # Follow GraceOS: Settings → Appearance writes ~/.config/grace/desktop.conf.
            self._watcher = QFileSystemWatcher(self)
            os.makedirs(os.path.dirname(conf_path), exist_ok=True)
            self._watcher.addPath(os.path.dirname(conf_path))
            if os.path.exists(conf_path):
                self._watcher.addPath(conf_path)
            self._watcher.directoryChanged.connect(self._grace_changed)
            self._watcher.fileChanged.connect(self._grace_changed)

        def configure_profile(self, profile, private):
            settings = profile.settings()
            attributes = QWebEngineSettings.WebAttribute
            settings.setAttribute(attributes.JavascriptCanOpenWindows, False)  # pop-ups need a click
            settings.setAttribute(attributes.LocalContentCanAccessRemoteUrls, False)
            settings.setAttribute(attributes.FullScreenSupportEnabled, True)
            settings.setAttribute(attributes.ScreenCaptureEnabled, True)  # still asks first
            settings.setAttribute(attributes.ErrorPageEnabled, False)  # CottonCandy draws its own
            # Qt drops unknown schemes that scripts start. Clicked ones reach CottonPage.acceptNavigationRequest,
            # which hands mailto: to the mail app and refuses the rest (returning False stops Qt's xdg-open).
            settings.setUnknownUrlSchemePolicy(
                QWebEngineSettings.UnknownUrlSchemePolicy.AllowUnknownUrlSchemesFromUserInteraction
            )
            # "Allow once" means once: nothing is remembered, so a site asks again next time.
            profile.setPersistentPermissionsPolicy(QWebEngineProfile.PersistentPermissionsPolicy.AskEveryTime)
            profile.setSpellCheckEnabled(False)
            profile.downloadRequested.connect(self._on_download)
            handler = SchemeHandler(self, private)
            self._handlers.append(handler)
            profile.installUrlSchemeHandler(INTERNAL_SCHEME.encode(), handler)

        def _grace_changed(self, *_args):
            if os.path.exists(conf_path) and conf_path not in self._watcher.files():
                self._watcher.addPath(conf_path)  # editors replace the file, which drops the watch
            if read_grace():
                self.apply_theme()

        def apply_theme(self, initial=False):
            icon_cache.clear()
            tokens = tok()
            self.setPalette(self._palette(tokens))
            self.setStyleSheet(stylesheet(theme["accent"], theme["style"]))
            try:  # Pages that follow prefers-color-scheme match GraceOS (Qt 6.8+).
                self.styleHints().setColorScheme(Qt.ColorScheme.Dark if theme["style"] == "dark" else Qt.ColorScheme.Light)
            except AttributeError:
                pass
            if initial:
                return
            for widget in self.allWidgets():
                spec = getattr(widget, "_cc_icon", None)
                if spec is not None:
                    widget.setIcon(icon(*spec))
            for window in self.windows:
                for action in window.findChildren(QAction):
                    spec = getattr(action, "_cc_icon", None)
                    if spec is not None:
                        action.setIcon(icon(*spec))
                window.apply_theme()

        def _palette(self, tokens):
            palette = QPalette()
            roles = QPalette.ColorRole
            for role, value in (
                (roles.Window, tokens["window"]),
                (roles.WindowText, tokens["text"]),
                (roles.Base, tokens["desktop"]),
                (roles.AlternateBase, tokens["sidebar"]),
                (roles.Text, tokens["text"]),
                (roles.Button, tokens["window"]),
                (roles.ButtonText, tokens["text_control"]),
                (roles.ToolTipBase, tokens["panel"]),
                (roles.ToolTipText, tokens["text"]),
                (roles.PlaceholderText, tokens["text_secondary"]),  # AA on the field; text_tertiary isn't
                (roles.Highlight, tokens["accent_fill"]),
                (roles.HighlightedText, "#ffffff"),
                (roles.Link, tokens["accent_text"]),
            ):
                palette.setColor(role, QColor(value))
            palette.setColor(QPalette.ColorGroup.Disabled, roles.Text, QColor(tokens["text_tertiary"]))
            palette.setColor(QPalette.ColorGroup.Disabled, roles.ButtonText, QColor(tokens["text_tertiary"]))
            return palette

        def ensure_spinner(self):
            if not self._spinner.isActive():
                self._spinner.start()

        def _spin(self):
            self.spin_step += 1
            busy = False
            for window in self.windows:
                for tab in window._tabs:
                    if tab.loading:
                        busy = True
                        tab.label.icon.setPixmap(spinner_frame(self.spin_step).pixmap(16, 16))
            if not busy:
                self._spinner.stop()

        def downloads_directory(self):
            directory = QStandardPaths.writableLocation(QStandardPaths.StandardLocation.DownloadLocation)
            directory = directory or os.path.join(os.path.expanduser("~"), "Downloads")
            os.makedirs(directory, exist_ok=True)
            return directory

        def _on_download(self, request):
            directory = self.downloads_directory()
            name = safe_download_name(request.suggestedFileName() or request.downloadFileName())
            path = unique_path(directory, name, self._taken_paths)
            self._taken_paths.add(path)
            request.setDownloadDirectory(directory)
            request.setDownloadFileName(os.path.basename(path))
            request.accept()
            download = Download(request, path)
            self.downloads.insert(0, download)
            del self.downloads[20:]
            request.stateChanged.connect(lambda _state: self._taken_paths.discard(path) if not download.running() else None)
            self._download_timer.start()
            self._update_download_buttons()
            for window in self.windows:
                if window.isActiveWindow():
                    window._show_bubble("Downloading {}".format(os.path.basename(path)))
                    QTimer.singleShot(2500, lambda w=window: w._show_bubble(""))
                if window._downloads_card.isVisible():
                    window.refresh_downloads()

        def _update_download_buttons(self):
            running = [d for d in self.downloads if d.running()]
            total = sum(d.request.totalBytes() for d in running if d.request.totalBytes() > 0)
            received = sum(d.request.receivedBytes() for d in running if d.request.totalBytes() > 0)
            fraction = None if not running else (received / total if total else 0.0)
            for window in self.windows:
                window._downloads_button.set_progress(fraction)
                if window._downloads_card.isVisible():
                    for row in window._downloads_card.findChildren(DownloadRow):
                        row.refresh()
            if not running:
                self._download_timer.stop()

        def known_icon(self, url):
            host = _host(url)
            if not host:
                return None
            if host not in self._icons:
                png = self.store.icon_for(url)
                pixmap = QPixmap()
                self._icons[host] = QIcon(pixmap) if png and pixmap.loadFromData(png, "PNG") else None
            return self._icons[host]

        def forget_icon(self, url):
            self._icons.pop(_host(url), None)

        def remember_closed(self, url, title):
            self.recently_closed = [(url, title)] + [entry for entry in self.recently_closed if entry[0] != url][:9]

        def listen(self, path):
            self.server = QLocalServer(self)
            self.server.setSocketOptions(QLocalServer.SocketOption.UserAccessOption)
            QLocalServer.removeServer(path)
            if not self.server.listen(path):
                print("cottoncandy: {}; links from other apps open new copies".format(self.server.errorString()), file=sys.stderr)
                return
            self.server.newConnection.connect(self._on_connection)

        def _on_connection(self):
            while self.server.hasPendingConnections():
                socket = self.server.nextPendingConnection()
                buffer = bytearray()

                def read(socket=socket, buffer=buffer):
                    buffer.extend(bytes(socket.readAll()))
                    if len(buffer) > MAX_REQUEST_BYTES:
                        socket.abort()

                def finished(socket=socket, buffer=buffer):
                    read()
                    request = decode_request(bytes(buffer))
                    socket.deleteLater()
                    if request is not None:
                        self.handle(request)

                socket.readyRead.connect(read)
                socket.disconnected.connect(finished)

        def handle(self, request):
            urls = [url for url in (argument_to_url(item, request["cwd"]) for item in request["urls"]) if url]
            refused = len(request["urls"]) - len(urls)
            if refused:
                print("cottoncandy: refused {} address(es) with an unsafe scheme".format(refused), file=sys.stderr)
            target = None
            if not request["new_window"]:
                matching = [window for window in self.windows if window.private == request["private"]]
                active = self.activeWindow()
                target = active if active in matching else (matching[-1] if matching else None)
            if target is None:
                self.create_window(urls, private=request["private"])
                return
            for url in urls or [HOME_URL]:
                target.add_tab(url)
            target.show()
            target.raise_()
            target.activateWindow()

        def create_window(self, urls=None, private=False):
            window = CottonWindow(self, private=private)
            self.windows.append(window)
            for url in urls or [HOME_URL]:
                window.add_tab(url, focus=False)
            window._tab_bar.setCurrentIndex(0)
            window.show()
            return window

        def window_closed(self, window):
            if window in self.windows:
                self.windows.remove(window)

        def clear_history(self):
            self.store.clear_history()
            self.profile.clearAllVisitedLinks()
            for window in self.windows:
                window.refresh_toolbar()

    socket_path = runtime_socket_path()
    request = encode_request(options.urls, os.getcwd(), options.new_window, options.private)
    app = CottonApplication()

    # A browser is already running: hand it the addresses and let it open them.
    client = QLocalSocket()
    client.connectToServer(socket_path)
    if client.waitForConnected(500):
        client.write(request)
        client.waitForBytesWritten(1000)
        client.disconnectFromServer()
        if client.state() != QLocalSocket.LocalSocketState.UnconnectedState:
            client.waitForDisconnected(1000)
        return 0

    app.start()
    app.listen(socket_path)
    app.handle(decode_request(request))
    status = app.exec()
    # Delete the closed windows' pages before the profiles they belong to.
    QApplication.sendPostedEvents(None, QEvent.Type.DeferredDelete)
    app.store.close()
    return status


if __name__ == "__main__":
    sys.exit(main())
