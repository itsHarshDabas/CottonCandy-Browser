        # ---- what the panel offers for the current tab ----

        def refresh(self):
            if not self.isVisible():
                return
            tab = self._window.current_tab()
            url = tab.url() if tab is not None else ""
            on_error = tab is not None and bool(tab.error_url) and tab.error_url == url
            readable = tab is not None and not on_error and url_scheme(url) in ("http", "https", "file")
            remote = self._remote_host()
            if self._kind is None:
                if readable:
                    self._about.setText("This page: " + (tab.view.title() or url_parts(url)["host"] or url))
                elif on_error:
                    self._about.setText("This page didn’t load.")
                else:
                    self._about.setText("Open a web page to summarize it or ask about it.")
            self._summarize.setVisible(not on_error)
            self._summarize.setEnabled(readable and not remote and not self.running)
            self._explain.setVisible(on_error)
            self._explain.setEnabled(not remote and not self.running)
            self._question.setVisible(not on_error)
            self._question.setEnabled(readable and not remote and not self.running)
            follow_up = self._kind == "done" and self._subject_url == url
            self._question.setPlaceholderText("Ask a follow-up about this page" if follow_up else "Ask about this page")
            if remote:
                self._chip.setText("Not on this device · " + remote)
                self._chip.setProperty("remote", True)
                self._download.hide()
                self._show_message(error=True, text="CherryCola is set to use a model server at {}. Grace in CottonCandy only uses a model on this computer, so it stays off. To use it, change ollama_url or lmstudio_url in ~/.config/grace/cherrycola.conf.".format(remote))
            else:
                if self._message.text().startswith("CherryCola is set to use"):
                    self._message.hide()
                model = (self._status or {}).get("model")
                self._chip.setText("Local AI · on this device" + (" · " + model if model else ""))
                self._chip.setProperty("remote", False)
            repolish(self._chip)

        def _remote_host(self):
            return model_server_host(read_text(cherrycola_conf), (self._status or {}).get("backend"))

        def _check_status(self):
            process = QProcess(self)
            process.setProgram(GRACE_COMMAND)
            process.setArguments(["status", "--json"])

            def done(_code=0, _status=None):
                self._status = grace_status(bytes(process.readAllStandardOutput()).decode("utf-8", "replace"))
                process.deleteLater()
                self.refresh()

            def failed(error):
                if error == QProcess.ProcessError.FailedToStart:
                    process.deleteLater()
                    self._status = None
                    self.refresh()
                    if not self.running and self._kind is None:
                        self._fail(*grace_failure(None))

            process.finished.connect(done)
            process.errorOccurred.connect(failed)
            process.start()

        # ---- running cherrycola ----

        def run(self, action, question=""):
            """action: summarize, ask, error (the tab's failed load) or question (typed; no page)."""
            if not theme["ai"] or self.running:
                return
            tab = self._window.current_tab()
            if tab is None:
                return
            remote = self._remote_host()
            if remote:
                self.refresh()
                return
            url, title = tab.url(), tab.view.title()
            if action == "ask":
                question = self._question.text().strip()
                if not question:
                    return
            self._run += 1
            run = self._run
            self._subject_url = url
            host = url_parts(url)["host"] or url
            self._begin(action, host if action == "error" else title or host, question)
            if action == "question":
                self._start(run, grace_prompt("question", question=question))
            elif action == "error":
                self._start(run, grace_prompt("error", url=tab.error_url or url, error=tab.error_text))
            else:
                def read(result):
                    if run != self._run:
                        return  # stopped, or another run started
                    text, cut = clean_page_text(result if isinstance(result, str) else "")
                    if not text:
                        self._fail("error", "This page has no text Grace can read.")
                        return
                    if cut:
                        self._about.setText(self._about.text() + " (the first {:,} characters)".format(len(text)))
                    self._start(run, grace_prompt(action, title, url, text, question))

                tab.page.runJavaScript(READ_PAGE_SCRIPT, APPLICATION_WORLD, read)

        def _begin(self, action, subject, question):
            self._kind = "running"
            self._about.setText({
                "summarize": "Summary of " + subject,
                "ask": "“{}” about {}".format(question, subject),
                "error": "Why {} didn’t load".format(subject),
                "question": "“{}”".format(question),
            }[action])
            self._answer.clear()
            self._answer.setPlaceholderText("Reading the page…" if action in ("summarize", "ask") else "Thinking…")
            self._answer.show()
            self._spacer.hide()
            self._message.hide()
            self._download.hide()
            self._copy.hide()
            self._stop.show()
            self._question.clear()
            self.refresh()

        def _start(self, run, prompt):
            self._answer.setPlaceholderText("Thinking… (the first answer can take a while: the model has to load)")
            self._stderr = b""
            self._decoder = codecs.getincrementaldecoder("utf-8")(errors="replace")
            process = QProcess(self)
            process.setProgram(GRACE_COMMAND)
            process.setArguments(["ask", "-"])  # the prompt goes on stdin, never on the command line
            process.readyReadStandardOutput.connect(lambda: self._read(process))
            process.readyReadStandardError.connect(lambda: self._read_error(process))
            process.finished.connect(lambda code, status: self._finished(process, code, status))
            process.errorOccurred.connect(lambda error: self._process_error(process, error))
            self._process = process
            process.start()
            process.write(prompt.encode("utf-8"))
            process.closeWriteChannel()
            self.refresh()

        def _read(self, process):
            if process is not self._process:
                return
            piece = self._decoder.decode(bytes(process.readAllStandardOutput()))
            if piece:
                cursor = self._answer.textCursor()
                cursor.movePosition(cursor.MoveOperation.End)
                cursor.insertText(piece)
                self._answer.ensureCursorVisible()

        def _read_error(self, process):
            if process is self._process:
                self._stderr = (self._stderr + bytes(process.readAllStandardError()))[-4000:]

        def _finished(self, process, code, status):
            if process is not self._process:
                return
            self._read(process)
            self._read_error(process)
            self._process = None
            process.deleteLater()
            self._stop.hide()
            if status == QProcess.ExitStatus.CrashExit:
                self._kind = "done"
                self._show_message("CherryCola stopped unexpectedly.", error=True)
            elif code == 0:
                self._answer.setPlainText(self._answer.toPlainText().strip())
                self._kind = "done"
                self._copy.show()
            else:
                self._fail(*grace_failure(code, self._stderr.decode("utf-8", "replace")))
            self.refresh()

        def _process_error(self, process, error):
            if process is self._process and error == QProcess.ProcessError.FailedToStart:
                self._process = None
                process.deleteLater()
                self._stop.hide()
                self._fail(*grace_failure(None))

        def _fail(self, kind, message):
            self._kind = "done" if self._answer.toPlainText() else None
            if not self._answer.toPlainText():
                self._answer.hide()
                self._spacer.show()
            self._stop.hide()
            self._show_message(message, error=True)
            self._download.setVisible(kind == "model-missing")
            self.refresh()

        def _show_message(self, text, error=False):
            self._message.setText(text)
            self._message.setProperty("error", error)
            repolish(self._message)
            self._message.show()

        def stop(self):
            self._run += 1
            process, self._process = self._process, None
            if process is not None:
                process.kill()
                process.waitForFinished(2000)
                process.deleteLater()
                self._kind = "done"
                self._show_message("Stopped.")
            elif self._kind == "running":
                self._kind = None  # still reading the page: nothing was sent
            self._stop.hide()
            if self._answer.toPlainText():
                self._copy.show()
            else:
                self._answer.hide()
                self._spacer.show()
            self.refresh()

        def _pull(self):
            """Downloading is the user's call: run `cherrycola pull` in their terminal, so they see the progress."""
            if shutil.which("grace-launch") and QProcess.startDetached("grace-launch", ["run", GRACE_COMMAND, "pull"])[0]:
                self._show_message("Downloading in a terminal window. Try again when it’s done.")
            else:
                self._show_message("Run “cherrycola pull” in a terminal to download the model, then try again.")
            self._download.hide()

    class CottonWindow(QMainWindow):
        def __init__(self, application, private=False):
            super().__init__()
            self._application = application
            self._private = private
            if private:
                # Off the record: cookies, cache and permissions live in memory and end with this window.
                self._profile = QWebEngineProfile(self)
                application.configure_profile(self._profile, private=True)
            else:
                self._profile = application.profile
            self._tabs = []
            self._closed = False
            self._entered = None
            self._suggestions = []
            self._selected = -1
            self.setWindowFlag(Qt.WindowType.FramelessWindowHint)
            self.setWindowTitle(window_title(None, private))
            self.resize(1200, 800)
            self._build_actions()
            self._build_ui()

        def application(self):
            return self._application

        @property
        def private(self):
            return self._private

        def tab_at(self, index):
            return self._tabs[index] if 0 <= index < len(self._tabs) else None

        def current_tab(self):
            return self._current()

        def tab_for_page(self, page):
            for tab in self._tabs:
                if tab.page is page:
