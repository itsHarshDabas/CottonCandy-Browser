def _grace_value(text, key, allowed, default):
    """A value from ~/.config/grace/desktop.conf ('key = value  # comment'; the last one wins), like grace-launch."""
    value = None
    for line in (text or "").splitlines():
        match = re.match(r"^\s*%s\s*=\s*([^#\s]*)" % re.escape(key), line)
        if match:
            value = match.group(1)
    return value if value in allowed else default


