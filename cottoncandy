            for mode, mode_color in ((QIcon.Mode.Normal, color), (QIcon.Mode.Disabled, TEXT_TERTIARY)):
                renderer = QSvgRenderer(QByteArray(icon_markup(ICONS[name], mode_color, filled).encode("utf-8")))
                pixmap = QPixmap(48, 48)
                pixmap.fill(Qt.GlobalColor.transparent)
                painter = QPainter(pixmap)
                renderer.render(painter)
                painter.end()
                result.addPixmap(pixmap, mode)
            icon_cache[key] = result
        return icon_cache[key]

    def tool_button(icon_name, tooltip, callback=None):
        button = QToolButton()
        button.setIcon(icon(icon_name))
        button.setIconSize(QSize(18, 18))
        button.setToolTip(tooltip)
        button.setAutoRaise(True)
        button.setFocusPolicy(Qt.FocusPolicy.NoFocus)
        if callback is not None:
            button.clicked.connect(callback)
        return button

    class CottonPage(QWebEnginePage):
        """A page that refuses unknown URL schemes and opens new windows as tabs of its own window."""

        def __init__(self, profile, window, parent=None):
            super().__init__(profile, parent)
            self._window = window

        def acceptNavigationRequest(self, url, navigation_type, is_main_frame):
            types = QWebEnginePage.NavigationType
            text = url.toString()
            decision = navigation_decision(
                text,
                is_main_frame,
                typed=navigation_type == types.NavigationTypeTyped,
                user_initiated=navigation_type == types.NavigationTypeLinkClicked,
            )
            if decision == "handoff":
                QDesktopServices.openUrl(url)
                return False
            if decision == "block":
                print("cottoncandy: blocked a navigation to {!r}".format(text[:200]), file=sys.stderr)
                return False
            return True

        def createWindow(self, window_type):
            background = window_type == QWebEnginePage.WebWindowType.WebBrowserBackgroundTab
            tab = self._window.add_tab(None, focus=not background, after=self)
            return tab.page

    class CottonTab:
        def __init__(self, window, profile):
            self.view = QWebEngineView()
            self.page = CottonPage(profile, window, self.view)
            self.view.setPage(self.page)
            self.devtools = None
            self.loading = False

    class AddressBar(QLineEdit):
        def focusInEvent(self, event):
            super().focusInEvent(event)
            # Select everything when the user comes to the bar, but not when the suggestions
            # popup hands focus back mid-typing (PopupFocusReason): that would eat the next key.
            reason = event.reason()
            if reason == Qt.FocusReason.MouseFocusReason:
                QTimer.singleShot(0, self.selectAll)  # after the click's own cursor placement
            elif reason in (Qt.FocusReason.TabFocusReason, Qt.FocusReason.BacktabFocusReason,
                            Qt.FocusReason.ShortcutFocusReason):
                self.selectAll()

        def keyPressEvent(self, event):
            if event.key() == Qt.Key.Key_Escape:
                self.window().restore_address()
                return
            super().keyPressEvent(event)

    class DownloadRow(QWidget):
        def __init__(self, request, path, on_finished):
            super().__init__()
            self._request = request
            self._path = path
            self._on_finished = on_finished
            self._name = QLabel(os.path.basename(path))
            self._name.setStyleSheet("font-weight: 600;")
            self._status = QLabel()
            self._status.setObjectName("secondary")
            self._progress = QProgressBar()
            self._progress.setTextVisible(False)
            self._cancel = tool_button("x", "Cancel", request.cancel)
            self._folder = tool_button("folder", "Show in folder", self._show_folder)

            text = QVBoxLayout()
            text.setSpacing(3)
            text.addWidget(self._name)
            text.addWidget(self._progress)
            text.addWidget(self._status)
            layout = QHBoxLayout(self)
            layout.setContentsMargins(8, 6, 4, 6)
            layout.addLayout(text, 1)
            layout.addWidget(self._cancel)
            layout.addWidget(self._folder)

            request.receivedBytesChanged.connect(self._refresh)
            request.totalBytesChanged.connect(self._refresh)
            request.stateChanged.connect(self._refresh)
            self._refresh()

        def _refresh(self, *_args):
            states = QWebEngineDownloadRequest.DownloadState
            state = self._request.state()
            received = self._request.receivedBytes()
            total = self._request.totalBytes()
            running = state in (states.DownloadRequested, states.DownloadInProgress)
            self._cancel.setVisible(running)
            self._progress.setVisible(running)
            if total > 0:
                self._progress.setRange(0, 1000)
                self._progress.setValue(int(received * 1000 / total))
            else:
                self._progress.setRange(0, 0)
            if state == states.DownloadCompleted:
                self._status.setText("Done, {}".format(format_bytes(received)))
            elif state == states.DownloadCancelled:
                self._status.setText("Cancelled")
            elif state == states.DownloadInterrupted:
                self._status.setText("Failed: {}".format(self._request.interruptReasonString()))
            elif total > 0:
                self._status.setText("{} of {}".format(format_bytes(received), format_bytes(total)))
            else:
                self._status.setText(format_bytes(received))
            if not running:
                self._on_finished(self._path)

        def _show_folder(self):
            # Only the folder: opening a downloaded file straight from the browser is how malware runs.
            QDesktopServices.openUrl(QUrl.fromLocalFile(os.path.dirname(self._path)))

    class DownloadsPanel(QFrame):
        def __init__(self):
            super().__init__(None, Qt.WindowType.Popup)
            self.setObjectName("downloads")
            self.setMinimumWidth(380)
            self._in_progress = set()
            self._list = QVBoxLayout()
            self._list.setSpacing(0)
            self._empty = QLabel("No downloads yet")
            self._empty.setObjectName("secondary")
            self._empty.setAlignment(Qt.AlignmentFlag.AlignCenter)
            self._empty.setMinimumHeight(60)
            layout = QVBoxLayout(self)
            layout.setContentsMargins(6, 6, 6, 6)
            title = QLabel("Downloads")
            title.setStyleSheet("font-weight: 600; padding: 4px 8px;")
            layout.addWidget(title)
            layout.addWidget(self._empty)
            layout.addLayout(self._list)

        def directory(self):
            directory = QStandardPaths.writableLocation(QStandardPaths.StandardLocation.DownloadLocation)
            directory = directory or os.path.join(os.path.expanduser("~"), "Downloads")
            os.makedirs(directory, exist_ok=True)
            return directory

        def add(self, request):
            directory = self.directory()
            name = safe_download_name(request.suggestedFileName() or request.downloadFileName())
            path = unique_path(directory, name, self._in_progress)
            self._in_progress.add(path)
            request.setDownloadDirectory(directory)
            request.setDownloadFileName(os.path.basename(path))
            request.accept()
            self._empty.hide()
            self._list.insertWidget(0, DownloadRow(request, path, self._in_progress.discard))
            while self._list.count() > 20:
                old = self._list.takeAt(self._list.count() - 1).widget()
                if old is not None:
                    old.deleteLater()
            return path

        def show_under(self, widget):
            # Wayland places popups relative to a parent window, so borrow the asking one.
            if self.parentWidget() is not widget.window():
                self.setParent(widget.window(), Qt.WindowType.Popup)
            self.adjustSize()
            corner = widget.mapToGlobal(widget.rect().bottomRight())
            self.move(corner.x() - self.width(), corner.y() + 4)
            self.show()

    class LibraryDialog(QDialog):
        """History or bookmarks: a search field and a list; activating a row opens it."""

        def __init__(self, window, kind):
            super().__init__(window)
            self._window = window
            self._kind = kind
            self.setWindowTitle("History" if kind == "history" else "Bookmarks")
            self.resize(560, 520)
            self._search = QLineEdit()
            self._search.setPlaceholderText("Search {}".format(self.windowTitle().lower()))
            self._search.setClearButtonEnabled(True)
            self._search.textChanged.connect(self.refresh)
            self._list = QListWidget()
            self._list.itemActivated.connect(self._open)
            buttons = QHBoxLayout()
            if kind == "history":
                clear = QPushButton("Clear History…")
                clear.setObjectName("destructive")
                clear.clicked.connect(self._clear)
                buttons.addWidget(clear)
            else:
                remove = QPushButton("Remove")
                remove.clicked.connect(self._remove)
                buttons.addWidget(remove)
            buttons.addStretch(1)
            open_button = QPushButton("Open")
            open_button.setObjectName("suggested")
            open_button.clicked.connect(lambda: self._open(self._list.currentItem()))
            buttons.addWidget(open_button)
            layout = QVBoxLayout(self)
            layout.addWidget(self._search)
            layout.addWidget(self._list, 1)
            layout.addLayout(buttons)
            self.refresh()

        def refresh(self, *_args):
            store = self._window.application().store
            rows = store.history(self._search.text()) if self._kind == "history" else store.bookmarks(self._search.text())
            self._list.clear()
            for url, title, stamp in rows:
                when = time.strftime("%d %b %Y, %H:%M", time.localtime(stamp))
                item = QListWidgetItem("{}\n{}  ·  {}".format(title or url, url, when))
                item.setData(Qt.ItemDataRole.UserRole, url)
                item.setToolTip(url)
                self._list.addItem(item)

        def _open(self, item):
            if item is not None:
                self._window.add_tab(item.data(Qt.ItemDataRole.UserRole))

        def _remove(self):
            item = self._list.currentItem()
            if item is not None:
                self._window.application().store.remove_bookmark(item.data(Qt.ItemDataRole.UserRole))
                self.refresh()
                self._window.refresh_toolbar()

        def _clear(self):
            answer = QMessageBox.question(
                self,
                "Clear History",
                "Remove every page from your history? Bookmarks, cookies and downloads stay.",
            )
            if answer == QMessageBox.StandardButton.Yes:
                self._window.application().clear_history()
                self.refresh()

    class CottonWindow(QMainWindow):
        def __init__(self, application, private=False):
            super().__init__()
            self._application = application
            self._private = private
            if private:
                # Off the record: cookies, cache and permissions live in memory and end with this window.
                self._profile = QWebEngineProfile(self)
                application.configure_profile(self._profile)
            else:
                self._profile = application.profile
            self._tabs = []
            self._closed = False
            self._entered = None
            self.setWindowTitle(window_title(None, private))
            self.resize(1200, 800)
            self._build_actions()
            self._build_ui()

        def application(self):
            return self._application

        @property
        def private(self):
            return self._private

        # ---- building ----

        def _build_actions(self):
            self._add_action("New Tab", self._on_new_tab, ["Ctrl+T"])
            self._add_action("Close Tab", self._on_close_tab, ["Ctrl+W", "Ctrl+F4"])
            self._add_action("New Window", lambda: self._application.create_window(), ["Ctrl+N"])
            self._add_action(
                "New Private Window",
                lambda: self._application.create_window(private=True),
                ["Ctrl+Shift+N"],
            )
            self._add_action("Focus Address", self._on_focus_address, ["Ctrl+L", "Alt+D", "F6"])
            self._add_action("Reload", self._on_reload, ["Ctrl+R", "F5"])
            self._add_action("Back", lambda: self._current_view_call("back"), ["Alt+Left"])
            self._add_action("Forward", lambda: self._current_view_call("forward"), ["Alt+Right"])
            self._add_action("Next Tab", lambda: self._cycle_tab(1), ["Ctrl+Tab", "Ctrl+PgDown"])
            self._add_action("Previous Tab", lambda: self._cycle_tab(-1), ["Ctrl+Shift+Tab", "Ctrl+PgUp"])
            self._add_action("Bookmark", self._on_toggle_bookmark, ["Ctrl+D"])
            self._add_action("History", lambda: self._show_library("history"), ["Ctrl+H"])
            self._add_action("Bookmarks", lambda: self._show_library("bookmarks"), ["Ctrl+Shift+O"])
            self._add_action("Downloads", self._on_show_downloads, ["Ctrl+Shift+Y"])
            self._add_action("Find", self._on_find, ["Ctrl+F"])
            self._add_action("Zoom In", lambda: self._zoom(0.1), ["Ctrl++", "Ctrl+="])
            self._add_action("Zoom Out", lambda: self._zoom(-0.1), ["Ctrl+-"])
            self._add_action("Reset Zoom", lambda: self._zoom(None), ["Ctrl+0"])
            self._add_action("Developer Tools", self._on_devtools, ["F12", "Ctrl+Shift+I"])
            self._add_action("Full Screen", self._on_toggle_fullscreen, ["F11"])
            self._add_action("Quit", QApplication.closeAllWindows, ["Ctrl+Q"])

        def _add_action(self, name, callback, shortcuts):
            action = QAction(name, self)
            action.setShortcuts([QKeySequence(shortcut) for shortcut in shortcuts])
            action.setShortcutContext(Qt.ShortcutContext.WindowShortcut)
            action.triggered.connect(lambda _checked=False: callback())
            self.addAction(action)
            return action

        def _build_ui(self):
            self._tab_bar = QTabBar()
            self._tab_bar.setDocumentMode(True)
            self._tab_bar.setDrawBase(False)
            self._tab_bar.setMovable(True)
