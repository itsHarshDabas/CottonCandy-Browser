        def set_url(self, url, bookmarked=False):
            self._url = url
            parts = url_parts(url)
            tokens = tok()
            kind = parts["kind"]
            names = {"secure": ("lock", "text_secondary", "The connection to this site is encrypted"),
                     "insecure": ("warning", "error", "Not secure: this page is sent unencrypted"),
                     "local": ("info", "text_secondary", "A page on this computer (not encrypted, never leaves it)"),
                     "file": ("file", "text_secondary", "A file on this computer")}
            name, role, tip = names.get(kind, ("search", "text_secondary", "Search or enter address"))
            set_icon(self.site, name, role)
            self.site.setToolTip(tip)
            self.notsecure.setVisible(kind == "insecure" and not self.editing)
            if kind == "empty":
                html = '<span style="color:{}">Search or enter address</span>'.format(tokens["text_secondary"])
            else:
                html = '<span style="color:{}">{}</span><span style="color:{}">{}</span>'.format(
                    tokens["text"], _esc(parts["host"]), tokens["text_secondary"], _esc(parts["rest"]))
            self.display.setText(html)
            self.star.setVisible(is_bookmarkable(url))
            set_icon(self.star, "star", "accent_text" if bookmarked else "text_control", filled=bookmarked)
            self.star.setToolTip("Remove bookmark (Ctrl+D)" if bookmarked else "Bookmark this page (Ctrl+D)")
            if self.editing and not self.edit.isModified():
                text = "" if kind == "empty" else url
                if self.edit.text() != text:
                    self.edit.setText(text)
                    self.edit.selectAll()  # still replaced by whatever is typed next

        def begin(self, select_all=True, text=None):
            self.editing = True
            self.notsecure.hide()
            self.edit.setText(text if text is not None else ("" if url_parts(self._url)["kind"] == "empty" else self._url))
            self.edit.setModified(text is not None)
            self.stack.setCurrentWidget(self.edit)
            self.setProperty("focused", True)
            repolish(self)
            self.edit.setFocus(Qt.FocusReason.ShortcutFocusReason)
            if select_all:
                self.edit.selectAll()
            if text:
                self.window_.update_suggestions(text)

        def finish(self):
            if not self.editing:
                return
            self.editing = False
            self.stack.setCurrentWidget(self.display)
            self.setProperty("focused", False)
            repolish(self)
            self.window_.hide_suggestions()
            self.set_url(self._url, self.window_.application().store.is_bookmarked(self._url))

        def cancel(self):
            self.finish()
            self.window_.focus_page()

    class Overlay(QFrame):
        """A popover card drawn inside the window (panel surface, hairline, shadow), anchored to a control."""

        def __init__(self, window, width):
            super().__init__(window.centralWidget())
            self.window_ = window
            self.setObjectName("overlay")
            self.setFixedWidth(width)
            self.anchor = None
            shadow(self)
            self.hide()

        def showEvent(self, event):
            super().showEvent(event)
            self.window_.sync_scrim()

        def hideEvent(self, event):
            super().hideEvent(event)
            self.window_.sync_scrim()

        def keyPressEvent(self, event):
            # Enter and Esc on a permission card mean Deny; only a click (or Space) on Allow once allows.
            if getattr(self, "kind", None) == "permission" and event.key() in (Qt.Key.Key_Return, Qt.Key.Key_Enter, Qt.Key.Key_Escape):
                self.window_.dismiss_overlays(escape=True)
                return
            super().keyPressEvent(event)

        def show_at(self, anchor, align="left"):
            self.anchor = anchor
            # Widgets added to an already visible popover start hidden; show all but the deliberately hidden ones.
            for child in self.findChildren(QWidget, options=Qt.FindChildOption.FindDirectChildrenOnly):
                if not child.testAttribute(Qt.WidgetAttribute.WA_WState_ExplicitShowHide):
                    child.show()
            self.adjustSize()
            parent = self.parentWidget()
            top_left = anchor.mapTo(parent, QPoint(0, anchor.height() + 6))
            if align == "right":
                x = anchor.mapTo(parent, QPoint(anchor.width(), 0)).x() - self.width()
            else:
                x = top_left.x() - 1
            x = max(6, min(x, parent.width() - self.width() - 6))
            self.move(x, top_left.y())
            self.show()
            self.raise_()

    def clear_layout(layout):
        while layout.count():
            item = layout.takeAt(0)
            if item.widget() is not None:
                item.widget().deleteLater()
            elif item.layout() is not None:
                clear_layout(item.layout())

