def set_default_handlers(text, desktop_id=DESKTOP_FILE, mime_types=HANDLER_TYPES):
    """mimeapps.list text with desktop_id as the default for mime_types; other lines are kept as they are."""
    lines = (text or "").splitlines()
    output = []
    in_defaults = False
    seen_defaults = False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            if in_defaults:
                output.extend("{}={}".format(mime, desktop_id) for mime in mime_types)
            in_defaults = stripped == "[Default Applications]"
            seen_defaults = seen_defaults or in_defaults
            output.append(line)
            continue
        if in_defaults and stripped.split("=", 1)[0].strip() in mime_types:
            continue
        output.append(line)
    if in_defaults:
        while output and not output[-1].strip():
            output.pop()
        output.extend("{}={}".format(mime, desktop_id) for mime in mime_types)
    if not seen_defaults:
        if output and output[-1].strip():
            output.append("")
        output.append("[Default Applications]")
        output.extend("{}={}".format(mime, desktop_id) for mime in mime_types)
    return "\n".join(output) + "\n"


def config_home(environ=os.environ):
    return environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")


def data_directory(environ=os.environ):
    base = environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local", "share")
    return os.path.join(base, "cottoncandy")


def cache_directory(environ=os.environ):
    base = environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
    return os.path.join(base, "cottoncandy")


def runtime_socket_path(environ=os.environ, uid=None):
    runtime = environ.get("XDG_RUNTIME_DIR")
    if runtime and os.path.isdir(runtime):
        return os.path.join(runtime, "cottoncandy.sock")
    uid = os.getuid() if uid is None else uid
    return os.path.join(tempfile.gettempdir(), "cottoncandy-{}.sock".format(uid))


def make_default_browser(environ=os.environ):
    path = os.path.join(config_home(environ), "mimeapps.list")
    try:
        with open(path, encoding="utf-8") as handle:
            text = handle.read()
    except FileNotFoundError:
        text = ""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as handle:
        handle.write(set_default_handlers(text))
    return path


def encode_request(urls, cwd, new_window=False, private=False):
    """What a second `cottoncandy URL` sends to the running browser."""
    return json.dumps(
        {"urls": list(urls), "cwd": cwd, "new_window": bool(new_window), "private": bool(private)}
    ).encode("utf-8")


def decode_request(data):
    """The request another cottoncandy process sent, or None if it isn't a well-formed one."""
    if not data or len(data) > MAX_REQUEST_BYTES:
        return None
    try:
        request = json.loads(bytes(data).decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        return None
    if not isinstance(request, dict):
        return None
    urls = request.get("urls")
    cwd = request.get("cwd")
    if not isinstance(urls, list) or len(urls) > 100 or not all(isinstance(url, str) for url in urls):
        return None
    if not isinstance(cwd, str):
        return None
    return {
        "urls": urls,
        "cwd": cwd,
        "new_window": request.get("new_window") is True,
        "private": request.get("private") is True,
    }


def icon_markup(path, color, filled=False):
    return (
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="{fill}" stroke="{color}" '
        'stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="{path}"/></svg>'
    ).format(fill=color if filled else "none", color=color, path=path)


def _host(url):
    match = re.match(r"^[A-Za-z][A-Za-z0-9+.-]*://([^/?#]*)", url or "")
    return match.group(1).rsplit("@", 1)[-1].lower() if match else ""


def _like(text):
    return "%" + text.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_") + "%"


class Store:
    """History, bookmarks and site icons in SQLite. Only http, https and file pages are stored."""

    SCHEMA_VERSION = 1

    def __init__(self, path):
        if path != ":memory:":
            os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
        self._db = sqlite3.connect(path)
        if path != ":memory:":
            os.chmod(path, 0o600)
        self._db.executescript(
            """
            CREATE TABLE IF NOT EXISTS history (
                url TEXT PRIMARY KEY,
                title TEXT NOT NULL DEFAULT '',
                visits INTEGER NOT NULL DEFAULT 0,
                last_visit INTEGER NOT NULL
            );
            CREATE INDEX IF NOT EXISTS history_last_visit ON history (last_visit DESC);
            CREATE TABLE IF NOT EXISTS bookmarks (
                url TEXT PRIMARY KEY,
                title TEXT NOT NULL DEFAULT '',
                created INTEGER NOT NULL
            );
            CREATE TABLE IF NOT EXISTS icons (
                host TEXT PRIMARY KEY,
                png BLOB NOT NULL,
                updated INTEGER NOT NULL
            );
            """
        )
        self._db.execute("PRAGMA user_version = {}".format(self.SCHEMA_VERSION))
        self._db.commit()

    def close(self):
        self._db.close()

    def record_visit(self, url, title="", now=None):
        if not is_web_url(url) and url_scheme(url) != "file":
            return False
        now = int(time.time()) if now is None else now
        with self._db:
            self._db.execute(
                """
                INSERT INTO history (url, title, visits, last_visit) VALUES (?, ?, 1, ?)
                ON CONFLICT (url) DO UPDATE SET
                    visits = visits + 1,
                    last_visit = excluded.last_visit,
                    title = CASE WHEN excluded.title != '' THEN excluded.title ELSE title END
                """,
                (url, title or "", now),
            )
        return True

    def set_title(self, url, title):
        if not title:
            return
        with self._db:
            self._db.execute("UPDATE history SET title = ? WHERE url = ?", (title, url))
            self._db.execute("UPDATE bookmarks SET title = ? WHERE url = ? AND title = ''", (title, url))

    def history(self, query="", limit=500):
        rows = self._db.execute(
            """
            SELECT url, title, last_visit FROM history
            WHERE url LIKE ? ESCAPE '\\' OR title LIKE ? ESCAPE '\\'
            ORDER BY last_visit DESC LIMIT ?
            """,
            (_like(query), _like(query), limit),
        )
        return rows.fetchall()

    def suggestions(self, text, limit=8):
        """URLs for the address bar: bookmarks first, then the most visited matches."""
        text = (text or "").strip()
        if not text:
            return []
        pattern = _like(text)
        rows = self._db.execute(
            """
            SELECT url FROM (
                SELECT url, 1 AS rank, 0 AS visits, created AS recent FROM bookmarks
                WHERE url LIKE ? ESCAPE '\\' OR title LIKE ? ESCAPE '\\'
                UNION ALL
                SELECT url, 2, visits, last_visit FROM history
                WHERE url LIKE ? ESCAPE '\\' OR title LIKE ? ESCAPE '\\'
            )
            GROUP BY url ORDER BY MIN(rank), MAX(visits) DESC, MAX(recent) DESC LIMIT ?
            """,
            (pattern, pattern, pattern, pattern, limit),
        )
        return [row[0] for row in rows.fetchall()]

    def clear_history(self):
        with self._db:
            self._db.execute("DELETE FROM history")

    def add_bookmark(self, url, title="", now=None):
        if not is_bookmarkable(url):
            return False
        now = int(time.time()) if now is None else now
        with self._db:
            self._db.execute(
                "INSERT INTO bookmarks (url, title, created) VALUES (?, ?, ?) "
                "ON CONFLICT (url) DO UPDATE SET title = excluded.title",
                (url, title or "", now),
            )
        return True

    def remove_bookmark(self, url):
        with self._db:
            self._db.execute("DELETE FROM bookmarks WHERE url = ?", (url,))

    def is_bookmarked(self, url):
        row = self._db.execute("SELECT 1 FROM bookmarks WHERE url = ?", (url,)).fetchone()
        return row is not None

    def bookmark_matches(self, text, limit=5):
        """(url, title) bookmarks whose address or title contains text."""
        pattern = _like((text or "").strip())
        rows = self._db.execute(
            "SELECT url, title FROM bookmarks WHERE url LIKE ? ESCAPE '\\' OR title LIKE ? ESCAPE '\\' "
            "ORDER BY created DESC LIMIT ?",
            (pattern, pattern, limit),
        )
        return rows.fetchall()

    def history_matches(self, text, limit=10):
        """(url, title) history entries containing text, most visited first."""
        pattern = _like((text or "").strip())
        rows = self._db.execute(
            "SELECT url, title FROM history WHERE url LIKE ? ESCAPE '\\' OR title LIKE ? ESCAPE '\\' "
            "ORDER BY visits DESC, last_visit DESC LIMIT ?",
            (pattern, pattern, limit),
        )
        return rows.fetchall()

    def top_sites(self, limit=8):
        """(url, title) of the most visited web pages, one per host, for the new tab page."""
        rows = self._db.execute(
            "SELECT url, title FROM history ORDER BY visits DESC, last_visit DESC LIMIT 200"
        ).fetchall()
        seen, result = set(), []
        for url, title in rows:
            host = _host(url)
            if not is_web_url(url) or not host or host in seen:
                continue
            seen.add(host)
            result.append((url, title))
            if len(result) == limit:
                break
        return result

    def set_icon(self, url, png, now=None):
        host = _host(url)
        if not png or not host or not is_web_url(url) or len(png) > 256 * 1024:
            return False
        now = int(time.time()) if now is None else now
        with self._db:
            self._db.execute(
                "INSERT INTO icons (host, png, updated) VALUES (?, ?, ?) "
                "ON CONFLICT (host) DO UPDATE SET png = excluded.png, updated = excluded.updated",
                (host, png, now),
            )
        return True

    def icon_for(self, url):
        row = self._db.execute("SELECT png FROM icons WHERE host = ?", (_host(url),)).fetchone()
        return bytes(row[0]) if row else None

    def bookmarks(self, query=""):
        rows = self._db.execute(
            """
            SELECT url, title, created FROM bookmarks
            WHERE url LIKE ? ESCAPE '\\' OR title LIKE ? ESCAPE '\\'
            ORDER BY created DESC
            """,
            (_like(query), _like(query)),
        )
        return rows.fetchall()


