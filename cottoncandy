    class Download:
        """A download and what's needed to show it: its final path and recent speed samples."""

        def __init__(self, request, path):
            self.request = request
            self.path = path
            self.samples = [(time.monotonic(), 0)]

        def running(self):
            states = QWebEngineDownloadRequest.DownloadState
            return self.request.state() in (states.DownloadRequested, states.DownloadInProgress)

        def status(self):
            states = QWebEngineDownloadRequest.DownloadState
            request = self.request
            state, received, total = request.state(), request.receivedBytes(), request.totalBytes()
            if state == states.DownloadCompleted:
                return "Done · " + format_bytes(received), False
            if state == states.DownloadCancelled:
                return "Cancelled", False
            if state == states.DownloadInterrupted:
                return "Failed: " + (request.interruptReasonString() or "unknown error"), True
            if request.isPaused():
                return "Paused · {} of {}".format(format_bytes(received), format_bytes(total) if total > 0 else "unknown size"), False
            now = time.monotonic()
            self.samples = [s for s in self.samples if now - s[0] < 3] + [(now, received)]
            first = self.samples[0]
            speed = (received - first[1]) / (now - first[0]) if now - first[0] > 0.3 else 0
            parts = [format_bytes(received) + (" of " + format_bytes(total) if total > 0 else "")]
            if speed > 0:
                parts.append(format_speed(speed))
                if total > 0:
                    parts.append(format_eta((total - received) / speed))
            return " · ".join(parts), False

