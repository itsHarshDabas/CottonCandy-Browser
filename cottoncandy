    def read_text(path):
        try:
            with open(path, encoding="utf-8") as handle:
                return handle.read()
        except (OSError, UnicodeDecodeError):
            return ""

    def read_grace():
        """Pick up GraceOS's Dark Style, accent and AI switch; True if any changed."""
        text = read_text(conf_path)
        new = {"style": grace_style(text), "accent": grace_accent(text), "ai": grace_ai(text)}
        changed = new != theme
        theme.update(new)
        return changed

    read_grace()

    def tok():
        return theme_tokens(theme["style"], theme["accent"])

    def qcolor(value):
        match = re.match(r"rgba\(([\d.]+),\s*([\d.]+),\s*([\d.]+),\s*([\d.]+)\)", value)
        if match:
            red, green, blue, alpha = match.groups()
            return QColor(int(red), int(green), int(blue), round(float(alpha) * 255))
        return QColor(value)

    icon_cache = {}

    def icon(name, role="text_control", filled=False):
        """A line icon in a theme color (a token name such as 'accent_text', or a hex color)."""
        tokens = tok()
        color = tokens.get(role, role)
        key = (name, color, filled, tokens["text_tertiary"])
        if key not in icon_cache:
            result = QIcon()
            for mode, mode_color in ((QIcon.Mode.Normal, color), (QIcon.Mode.Disabled, tokens["text_tertiary"])):
                renderer = QSvgRenderer(QByteArray(icon_markup(ICONS[name], mode_color, filled).encode("utf-8")))
                pixmap = QPixmap(48, 48)
                pixmap.fill(Qt.GlobalColor.transparent)
                painter = QPainter(pixmap)
                renderer.render(painter)
                painter.end()
                result.addPixmap(pixmap, mode)
            icon_cache[key] = result
        return icon_cache[key]

    def set_icon(widget, name, role="text_control", filled=False):
        """Give a button a themed icon that follows later theme changes."""
        widget._cc_icon = (name, role, filled)
        widget.setIcon(icon(name, role, filled))

    def tool_button(icon_name, tooltip, callback=None, size=30, role="text_control"):
        button = QToolButton()
        set_icon(button, icon_name, role)
        button.setFixedSize(size, size)
        button.setIconSize(QSize(16, 16) if size >= 28 else QSize(14, 14))
        if size < 28:
            button.setObjectName("small")
        button.setToolTip(tooltip)
        button.setAccessibleName(tooltip.split(" (")[0])
        button.setFocusPolicy(Qt.FocusPolicy.TabFocus)
        if callback is not None:
            button.clicked.connect(lambda _checked=False: callback())
        return button

    def repolish(widget):
        widget.style().unpolish(widget)
        widget.style().polish(widget)

    spinner_cache = {}

    def spinner_frame(step):
        """The loading spinner (accent text color on the track), one of 12 frames."""
        tokens = tok()
        key = (step % 12, tokens["accent_text"], tokens["track"])
        if key not in spinner_cache:
            pixmap = QPixmap(32, 32)
            pixmap.fill(Qt.GlobalColor.transparent)
            painter = QPainter(pixmap)
            painter.setRenderHint(QPainter.RenderHint.Antialiasing)
            rect = QRectF(5, 5, 22, 22)
            painter.setPen(QPen(qcolor(tokens["track"]), 3.2))
            painter.drawEllipse(rect)
            pen = QPen(QColor(tokens["accent_text"]), 3.2)
            pen.setCapStyle(Qt.PenCapStyle.RoundCap)
            painter.setPen(pen)
            painter.drawArc(rect, (90 - step % 12 * 30) * 16, -90 * 16)
            painter.end()
            spinner_cache[key] = QIcon(pixmap)
        return spinner_cache[key]

    def png_bytes(qicon):
        pixmap = qicon.pixmap(32, 32)
        if pixmap.isNull():
            return None
        buffer = QBuffer()
        buffer.open(QIODevice.OpenModeFlag.WriteOnly)
        pixmap.save(buffer, "PNG")
        return bytes(buffer.data())

    def data_uri(png):
        return "data:image/png;base64," + base64.b64encode(png).decode("ascii") if png else None

