            self.folder = tool_button("folder", "Show in folder", self._show_folder, size=24)
            self.retry = tool_button("reload", "Try again", self._retry, size=24)
            row = QHBoxLayout(self)
            row.setContentsMargins(10, 8, 8, 8)
            row.setSpacing(10)
