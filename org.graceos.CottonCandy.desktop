[Desktop Entry]
Type=Application
Version=1.0
Name=CottonCandy
GenericName=Web Browser
Comment=Browse the web on GraceOS
Exec=cottoncandy %U
Icon=org.graceos.CottonCandy
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Keywords=web;browser;internet;chromium;
StartupNotify=true
StartupWMClass=org.graceos.CottonCandy
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Exec=cottoncandy --new-window

[Desktop Action new-private-window]
Name=New Private Window
Exec=cottoncandy --private
