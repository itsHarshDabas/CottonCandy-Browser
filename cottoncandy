def _hex(color):
    color = color.lstrip("#")
    return tuple(int(color[i : i + 2], 16) for i in (0, 2, 4))


def mix(color, other, amount):
    """color moved `amount` (0..1) of the way towards other, both #rrggbb."""
    a, b = _hex(color), _hex(other)
    return "#{:02x}{:02x}{:02x}".format(*(round(x + (y - x) * amount) for x, y in zip(a, b)))


def theme_tokens(style="dark", accent="blue"):
    style = style if style in THEMES else "dark"
    swatch = ACCENTS.get(accent, ACCENTS["blue"])
    tokens = dict(THEMES[style])
    tokens.update(
        style=style,
        accent_base=swatch["base"],
        accent_fill=swatch["fill"],
        accent_fill_hover=mix(swatch["fill"], "#000000", 0.10),
        accent_fill_pressed=mix(swatch["fill"], "#000000", 0.18),
        accent_text=swatch["fg"] if style == "dark" else swatch["fg_light"],
        tint=swatch["tint"] if style == "dark" else mix("#f3f4f6", swatch["base"], 0.14),
    )
    return tokens


def url_parts(url):
    """How the address bar shows a URL: kind (secure, insecure, local, file, internal, empty, other), host, rest."""
    scheme = url_scheme(url)
    if not url or url == "about:blank" or internal_request(url)[0] == "newtab":
        return {"kind": "empty", "host": "", "rest": ""}
    if scheme in ("http", "https"):
        match = re.match(r"^[A-Za-z]+://([^/?#]*)(.*)$", url)
        host, rest = (match.group(1), match.group(2)) if match else (url, "")
        hostname = re.sub(r":\d+$", "", host.rsplit("@", 1)[-1])
        if scheme == "https":
            kind = "secure"
        else:
            kind = "local" if is_local_host(hostname) else "insecure"
        return {"kind": kind, "host": host, "rest": "" if rest == "/" else rest}
    if scheme == "file":
        return {"kind": "file", "host": "file://", "rest": url[len("file://") :]}
    if scheme == INTERNAL_SCHEME:
        return {"kind": "internal", "host": url, "rest": ""}
    return {"kind": "other", "host": url, "rest": ""}


def format_speed(bytes_per_second):
    if not bytes_per_second or bytes_per_second <= 0:
        return ""
    return format_bytes(int(bytes_per_second)) + "/s"


def format_eta(seconds):
    if seconds is None or seconds < 0:
        return ""
    seconds = int(seconds)
    if seconds < 60:
        return "{} s left".format(max(seconds, 1))
    if seconds < 3600:
        return "{} min left".format(round(seconds / 60))
    return "{} h {} min left".format(seconds // 3600, (seconds % 3600) // 60)


def build_suggestions(text, open_tabs=(), bookmarks=(), history=(), search_url=SEARCH_URL, ai=False):
    """Grouped address-bar suggestions, all local: open tabs, bookmarks, history, the search itself, and with
    AI on, asking Grace (which runs only when that row is picked)."""
    query = (text or "").strip()
    if not query:
        return []
    needle = query.lower()
    rows = []
    seen = set()

    def matches(url, title):
        return needle in (url or "").lower() or needle in (title or "").lower()

    for url, title in open_tabs:
        if is_web_url(url) and matches(url, title) and url not in seen and len([r for r in rows if r["group"] == "Open tabs"]) < 2:
            rows.append({"group": "Open tabs", "title": title or url, "url": url, "kind": "tab"})
            seen.add(url)
    for group, source, limit in (("Bookmarks", bookmarks, 3), ("History", history, 5)):
        count = 0
        for url, title in source:
            if url in seen or not matches(url, title) or count >= limit:
                continue
            rows.append({"group": group, "title": title or url, "url": url, "kind": "page"})
            seen.add(url)
            count += 1
    target = resolve_input(query, search_url)
    if target is not None and target != search_url.format(quote_plus(query)):
        rows.append({"group": "Search", "title": query, "url": target, "kind": "address"})
    rows.append({"group": "Search", "title": query, "url": search_url.format(quote_plus(query)), "kind": "search"})
    if ai:
        rows.append({"group": "Search", "title": query, "url": "", "kind": "ask"})
    return rows


def error_kind(domain, code):
    """Which error page to show for a failed load (domain is QWebEngineLoadingInfo.ErrorDomain's name)."""
    if domain == "CertificateErrorDomain":
        return "cert"
    if code in (-106,):  # ERR_INTERNET_DISCONNECTED
        return "offline"
    if domain == "DnsErrorDomain" or code in (-105, -137):  # name not resolved
        return "dns"
    return "other"


