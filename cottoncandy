def parse_arguments(argv=None):
    arguments = argv
    if arguments:
        arguments = list(arguments)
        if os.path.basename(arguments[0]) in ("cottoncandy", "cottoncandy.py"):
            arguments = arguments[1:]
    parser = argparse.ArgumentParser(
        prog="cottoncandy",
        description="The web browser of GraceOS.",
    )
    parser.add_argument(
        "urls",
        nargs="*",
        metavar="URL",
        help="web addresses, files or search words to open in tabs",
    )
    parser.add_argument(
        "--new-window",
        action="store_true",
        help="open a new window instead of tabs in the current one",
    )
    parser.add_argument(
        "--private",
        action="store_true",
        help="open a private window: no history, cookies end when it closes",
    )
    parser.add_argument(
        "--set-default",
        action="store_true",
        help="make CottonCandy the default browser for this user and exit",
    )
    return parser.parse_args(arguments)


def url_scheme(text):
    match = re.match(r"^([A-Za-z][A-Za-z0-9+.-]*):", text or "")
    return match.group(1).lower() if match else None


HOST_PATTERN = re.compile(
    r"^(?P<host>localhost|\[[0-9A-Fa-f:.]+\]|\d{1,3}(?:\.\d{1,3}){3}"
    r"|(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+(?:[A-Za-z]{2,63}|xn--[A-Za-z0-9-]{1,59}))"
    r"(?::\d{1,5})?(?:[/?#].*)?$"
)


def looks_like_host(text):
    """True for 'example.org', 'localhost:8000/x' or '10.0.0.1': things to open, not to search for."""
    if not text or any(character.isspace() for character in text):
        return False
    return HOST_PATTERN.match(text) is not None


def _is_local_host(text):
    host = HOST_PATTERN.match(text).group("host")
    return host == "localhost" or host.startswith("[") or re.fullmatch(r"[\d.]+", host) is not None


def resolve_input(text, search_url=SEARCH_URL):
    """The URL to load for what was typed in the address bar, or None for nothing."""
    text = (text or "").strip()
    if not text:
        return None
    scheme = url_scheme(text)
    if scheme in OPENABLE_SCHEMES or scheme in HANDOFF_SCHEMES:
        return text
    if looks_like_host(text):
        # Local servers rarely have certificates; everything else is tried over HTTPS first.
        return ("http://" if _is_local_host(text) else "https://") + text
    return search_url.format(quote_plus(text))


def argument_to_url(argument, cwd):
    """A command-line argument as a URL: a file next to cwd, a URL, or a search. None for unsafe schemes."""
    if not argument:
        return None
    scheme = url_scheme(argument)
    if scheme is None or len(scheme) == 1:
        # len 1: a Windows-style "C:" path is still a path, not a scheme.
        path = os.path.join(cwd or "/", os.path.expanduser(argument))
        if os.path.exists(path):
            return Path(path).resolve().as_uri()
    if scheme is not None and scheme not in OPENABLE_SCHEMES and scheme not in HANDOFF_SCHEMES:
        if not looks_like_host(argument):
            return None
    return resolve_input(argument)


def navigation_decision(url, is_main_frame, typed=False, user_initiated=False):
    """'allow', 'handoff' (open in the user's default app) or 'block' for a navigation."""
    scheme = url_scheme(url)
    if scheme is None:
        return "block"
    if typed and scheme in OPENABLE_SCHEMES:
        return "allow"
    if scheme in HANDOFF_SCHEMES:
        return "handoff" if is_main_frame and (typed or user_initiated) else "block"
    if scheme == "data" and is_main_frame:
        # Chromium's rule too: pages may not navigate the whole tab to a data: URL (phishing).
        return "block"
    if scheme in PAGE_SCHEMES:
        return "allow"
    return "block"


def is_local_host(host):
    """Hosts that never leave this computer, so plain http to them is not a warning."""
    host = (host or "").strip("[]").lower()
    return host in ("localhost", "::1") or host.endswith(".localhost") or re.fullmatch(r"127(\.\d{1,3}){3}", host) is not None


def is_web_url(url):
    return url_scheme(url) in ("http", "https")


def is_bookmarkable(url):
    return url_scheme(url) in ("http", "https", "file")


def safe_download_name(suggested):
    """A file name that can't climb out of the downloads folder or hide itself."""
    name = (suggested or "").replace("\\", "/").split("/")[-1]
    name = "".join(character for character in name if character.isprintable())
    name = name.strip().lstrip(".").strip()
    if not name:
        return "download"
    if len(name) > 200:
        stem, extension = os.path.splitext(name)
        extension = extension[:20]
        name = stem[: 200 - len(extension)] + extension
    return name


def unique_path(directory, name, taken=()):
    stem, extension = os.path.splitext(name)
    candidate = os.path.join(directory, name)
    number = 1
    while os.path.exists(candidate) or candidate in taken:
        candidate = os.path.join(directory, "{} ({}){}".format(stem, number, extension))
        number += 1
    return candidate


def format_bytes(count):
    if count is None or count < 0:
        return "unknown size"
    value = float(count)
    for unit in ("B", "KB", "MB", "GB"):
        if value < 1000 or unit == "GB":
            return "{} {}".format(int(value) if unit == "B" else "{:.1f}".format(value), unit)
        value /= 1000
    return "{} B".format(count)


