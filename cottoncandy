    class CottonPage(QWebEnginePage):
        """Refuses unknown URL schemes, opens new windows as tabs, and handles cottoncandy: actions."""

        def __init__(self, profile, window, parent=None):
            super().__init__(profile, parent)
            self._window = window
            self.error_page_pending = False

        def acceptNavigationRequest(self, url, navigation_type, is_main_frame):
            types = QWebEnginePage.NavigationType
            text = url.toString()
            if url.scheme() == "data" and is_main_frame and self.error_page_pending:
                self.error_page_pending = False  # the error page CottonCandy itself just set
                return True
            if url.scheme() == INTERNAL_SCHEME and is_main_frame:
                kind, value = internal_request(text)
                from_internal = self.url().scheme() == INTERNAL_SCHEME
                if kind == "newtab" and navigation_type in (types.NavigationTypeTyped, types.NavigationTypeReload,
                                                            types.NavigationTypeBackForward, types.NavigationTypeOther):
                    return True  # browser-initiated; pages can't link here (that's LinkClicked or a form)
                if kind == "search" and from_internal:
                    target = resolve_input(value)
                    if target:
                        QTimer.singleShot(0, lambda: self.load(QUrl(target)))
                    return False
                if kind == "back":
                    QTimer.singleShot(0, lambda: self.triggerAction(QWebEnginePage.WebAction.Back))
                    return False
                if kind == "explain":
                    # Only the error page CottonCandy drew has this link, and only a click on it asks Grace.
                    tab = self._window.tab_for_page(self)
                    if (tab is not None and tab.error_url and tab.error_url == self.url().toString()
                            and navigation_type == types.NavigationTypeLinkClicked):
                        QTimer.singleShot(0, lambda: self._window.explain_error(tab))
                    return False
            decision = navigation_decision(
                text,
                is_main_frame,
                typed=navigation_type == types.NavigationTypeTyped,
                user_initiated=navigation_type == types.NavigationTypeLinkClicked,
            )
            if decision == "handoff":
                QDesktopServices.openUrl(url)
                return False
            if decision == "block":
                print("cottoncandy: blocked a navigation to {!r} ({})".format(text[:200], navigation_type.name), file=sys.stderr)
                return False
            return True

        def createWindow(self, window_type):
            background = window_type == QWebEnginePage.WebWindowType.WebBrowserBackgroundTab
            tab = self._window.add_tab(None, focus=not background, after=self)
            return tab.page

    class SchemeHandler(QWebEngineUrlSchemeHandler):
        """Serves cottoncandy://newtab, built from the theme, local history and favicons. Nothing else."""

        def __init__(self, application, private):
            super().__init__(application)
            self._application = application
            self._private = private

        def requestStarted(self, job):
            kind, _value = internal_request(job.requestUrl().toString())
            if kind != "newtab":
                job.fail(QWebEngineUrlRequestJob.Error.UrlNotFound)
                return
            store = self._application.store
            shortcuts = [(url, title, data_uri(store.icon_for(url))) for url, title in store.top_sites(8)]
            recent = [(url, title, data_uri(store.icon_for(url))) for url, title in self._application.recently_closed[:3]]
            local_ai = theme["ai"] and shutil.which(GRACE_COMMAND) is not None and model_server_host(read_text(cherrycola_conf)) is None
            html = newtab_html(tok(), shortcuts, recent, self._private, ai=local_ai)
            buffer = QBuffer(job)
            buffer.setData(html.encode("utf-8"))
